<Window x:Class="wpf_projeto_integrador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Station"
        Height="520"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#090414">

    <Grid>

        <!-- COLUNAS -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LADO ESQUERDO -->
        <Border Grid.Column="0">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#090414" Offset="0"/>
                    <GradientStop Color="#160724" Offset="0.55"/>
                    <GradientStop Color="#08020F" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>

                <!-- CIRCULO SOMBREADO -->
                <Ellipse Width="300"
                         Height="300"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="-170,0,0,-150"
                         Opacity="0.08"
                         Fill="#8B5CF6"/>

                <StackPanel Margin="50,0,35,0"
                            VerticalAlignment="Center">

                    <!-- LOGO -->
                    <Image Source="/fotos/logo_musicstation.png"
                           Width="250"
                           Stretch="Uniform"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,12"/>

                    <!-- SUBTITULO -->
                    <TextBlock Text="Sistema de Gestão Administrativa"
                               FontSize="14"
                               Foreground="#D7D3DF"
                               Margin="0,0,0,32"/>

                    <!-- LINHA -->
                    <Border Width="42"
                            Height="2"
                            Background="#F2B705"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,28"/>

                    <!-- TEXTO -->
                    <TextBlock Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit,
                                    &#xA; sed do eiusmod tempor incididunt."
                               FontSize="13"
                               LineHeight="21"
                               Foreground="#C9C3D4"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- DIVISÓRIA -->
        <Border Grid.Column="0"
                Width="1"
                HorizontalAlignment="Right"
                Background="#3D1F68"
                Opacity="0.7"/>

        <!-- FUNDO DIREITO -->
        <Border Grid.Column="1">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#160724" Offset="0"/>
                    <GradientStop Color="#0E0618" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

        </Border>

        <!-- CARD LOGIN -->
        
        <!-- CARD LOGIN -->
        <Grid Grid.Column="1">

            <Border Width="350"
            Height="430"
            Background="#1B1230"
            CornerRadius="14"
            BorderBrush="#4D2A7A"
            BorderThickness="1"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="22"
                              ShadowDepth="0"
                              Opacity="0.45"/>
                </Border.Effect>

                <StackPanel VerticalAlignment="Center">

                    <!-- TITULO -->
                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,4">

                        <TextBlock Text="👤"
                           FontSize="20"
                           Margin="0,0,8,0"
                           Foreground="#8B5CF6"/>

                        <TextBlock Text="Acesso ao sistema"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"/>
                    </StackPanel>

                    <!-- SUB -->
                    <TextBlock Text="Entre com suas credenciais"
                       FontSize="11"
                       Foreground="#C7C2D3"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18"/>

                    <Border Height="1"
                    Background="#34234D"
                    Margin="0,0,0,18"/>

                    <!-- USUARIO -->
                    <TextBlock Text="Usuário"
                       FontSize="12"
                       Foreground="White"
                       Margin="0,0,0,5"/>

                    <Border Height="40"
                    Background="#120A20"
                    BorderBrush="#5B2DBF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,14">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="👤"
                               FontSize="14"
                               Foreground="#B8B1C9"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                            <TextBox x:Name="txtUsuario"
                             Grid.Column="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             FontSize="12"
                             VerticalContentAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- SENHA -->
                    <TextBlock Text="Senha"
                       FontSize="12"
                       Foreground="White"
                       Margin="0,0,0,5"/>

                    <Border Height="40"
                    Background="#120A20"
                    BorderBrush="#5B2DBF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,16">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="🔒"
                               FontSize="14"
                               Foreground="#B8B1C9"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                            <PasswordBox x:Name="txtSenha"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"/>

                            
                        </Grid>
                    </Border>

                    <!-- OPCOES -->
                    <Grid Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="chkLembrar"
                          Content="Lembrar login"
                          Foreground="#D8D3E3"
                          FontSize="11"
                          VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                           Text="Esqueci minha senha"
                           Foreground="#F2B705"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Cursor="Hand"/>
                    </Grid>

                    <!-- BOTAO -->
                    <Button x:Name="btnEntrar"
                    Content="↪  Entrar"
                    Height="42"
                    FontSize="15"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand" Click="btnEntrar_Click_1">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border x:Name="border"
                                Background="#FFD21A"
                                CornerRadius="9">

                                    <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border"
                                        Property="Background"
                                        Value="#FFE66D"/>
                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border"
                                        Property="Background"
                                        Value="#E6BD17"/>
                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- TEXTO FINAL -->
                    <TextBlock Text="Acesso restrito para administradores"
                       FontSize="10"
                       Foreground="#C7C2D3"
                       HorizontalAlignment="Center"
                       Margin="0,18,0,0"/>

                </StackPanel>

            </Border>

        </Grid>
        


    </Grid>
</Window>