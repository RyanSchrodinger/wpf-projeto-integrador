<Window x:Class="wpf_projeto_integrador.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpf_projeto_integrador"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
    <DataGrid
    x:Name="dgUsuarios"
    AutoGenerateColumns="False"
    Background="#13142A"
    Foreground="White"
    BorderThickness="0"
    GridLinesVisibility="None"
    HeadersVisibility="Column"
    RowHeight="70"
    ColumnHeaderHeight="55"
    Margin="20"
    FontSize="15"
    CanUserAddRows="False">

        <!-- Estilo cabeçalho -->
        <DataGrid.ColumnHeaderStyle>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#1B1D3A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="20,0"/>
            </Style>
        </DataGrid.ColumnHeaderStyle>

        <!-- Estilo linhas -->
        <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="#191B36"/>
                <Setter Property="Margin" Value="0,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#24274A"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </DataGrid.RowStyle>

        <!-- Células -->
        <DataGrid.CellStyle>
            <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="15"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>
        </DataGrid.CellStyle>

        <DataGrid.Columns>

            <DataGridTextColumn Header="Usuário" Binding="{Binding Nome}" Width="3*" />

            <DataGridTemplateColumn Header="Tipo" Width="2*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Border
                        Background="#6C3BFF"
                        CornerRadius="10"
                        Padding="12,6"
                        HorizontalAlignment="Left">

                            <TextBlock
                            Text="{Binding Tipo}"
                            Foreground="White"
                            FontWeight="SemiBold"/>
                        </Border>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Ações" Width="3*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">

                            <Button Content="Editar"
                                Margin="5"
                                Background="#6C3BFF"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="15,8"/>

                            <Button Content="Detalhes"
                                Margin="5"
                                Background="#252849"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="15,8"/>

                            <Button Content="Excluir"
                                Margin="5"
                                Background="#FF3B5C"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="15,8"/>

                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

        </DataGrid.Columns>
    </DataGrid>
</Window>
