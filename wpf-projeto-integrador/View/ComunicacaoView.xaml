<UserControl x:Class="wpf_projeto_integrador.Views.ComunicacaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B1020">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LISTA DE CONVERSAS -->
        <Border Grid.Column="0"
                Background="#11182B"
                BorderBrush="#222B45"
                BorderThickness="0 0 1 0"
                Padding="22">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Comunicação"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Grid.Row="1"
                           Text="Converse com os administradores."
                           Foreground="#AEB6D3"
                           Margin="0 8 0 22"/>

                <Border Grid.Row="2"
                        Background="#151D33"
                        BorderBrush="#2A3555"
                        BorderThickness="1"
                        CornerRadius="10"
                        Height="46"
                        Margin="0 0 0 22">

                    <TextBox x:Name="TxtBuscarAdm"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             FontSize="14"
                             Padding="14 0"
                             VerticalContentAlignment="Center"
                             TextChanged="TxtBuscarAdm_TextChanged"/>
                </Border>

                <ListBox x:Name="ListaAdministradores"
                         Grid.Row="3"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="ListaAdministradores_SelectionChanged">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#151D33"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="0 0 0 12"
                                    BorderBrush="#26314F"
                                    BorderThickness="1">

                                <StackPanel Orientation="Horizontal">
                                    <Border Width="46"
                                            Height="46"
                                            CornerRadius="23"
                                            Background="#7C3AED">

                                        <TextBlock Text="{Binding Iniciais}"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Margin="12 0 0 0"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Nome}"
                                                   Foreground="White"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="{Binding Email}"
                                                   Foreground="#AEB6D3"
                                                   FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ÁREA DO CHAT -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="82"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="82"/>
            </Grid.RowDefinitions>

            <!-- TOPO -->
            <Border Grid.Row="0"
                    Background="#0E1426"
                    BorderBrush="#222B45"
                    BorderThickness="0 0 0 1"
                    Padding="26 0">

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Width="50"
                            Height="50"
                            CornerRadius="25"
                            Background="#7C3AED">

                        <TextBlock x:Name="TxtIniciaisTopo"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="14 0 0 0"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="TxtNomeContato"
                                   Text="Selecione um administrador"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                       
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- MENSAGENS -->
            <ScrollViewer x:Name="ScrollMensagens"
                          Grid.Row="1"
                          Padding="26"
                          VerticalScrollBarVisibility="Auto">

                <ItemsControl x:Name="ListaMensagens">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="BolhaMensagem"
                                    Background="#182138"
                                    CornerRadius="14"
                                    Padding="14"
                                    Margin="0 8"
                                    MaxWidth="480"
                                    HorizontalAlignment="Left">

                                <StackPanel>
                                    <TextBlock Text="{Binding Texto}"
                                               Foreground="White"
                                               FontSize="15"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding Hora}"
                                               Foreground="#AEB6D3"
                                               FontSize="11"
                                               HorizontalAlignment="Right"
                                               Margin="0 6 0 0"/>
                                </StackPanel>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding MinhaMensagem}" Value="True">
                                    <Setter TargetName="BolhaMensagem"
                                            Property="HorizontalAlignment"
                                            Value="Right"/>

                                    <Setter TargetName="BolhaMensagem"
                                            Property="Background"
                                            Value="#6D28D9"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ENVIAR -->
            <Border Grid.Row="2"
                    Background="#0E1426"
                    BorderBrush="#222B45"
                    BorderThickness="0 1 0 0"
                    Padding="26 14">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#151D33"
                            BorderBrush="#2A3555"
                            BorderThickness="1"
                            CornerRadius="12">

                        <TextBox x:Name="TxtMensagem"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontSize="14"
                                 Padding="14 0"
                                 VerticalContentAlignment="Center"/>
                    </Border>

                    <Button Grid.Column="1"
                            Content="➤"
                            Background="#7C3AED"
                            Foreground="White"
                            FontSize="22"
                            BorderThickness="0"
                            Margin="12 0 0 0"
                            Cursor="Hand"
                            Click="BtnEnviar_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>