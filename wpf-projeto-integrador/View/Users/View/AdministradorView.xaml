<UserControl x:Class="wpf_projeto_integrador.View.Users.AdministradorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="#0B1024">

   
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid >
            <StackPanel>
                <TextBlock Text="Administradores"
                           FontSize="31"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="Visão geral dos administradores cadastrados no sistema."
                           FontSize="14"
                       Foreground="#CBD5E1"
                           Margin="0 0 4 0 "/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1"
                     Columns="6"
                     Margin="0 18 0 10">

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextoCard}">Total de Administradores</TextBlock>
                    <TextBlock Style="{StaticResource NumeroCard}" Name="txtTotalAdministradores">0</TextBlock>
                    <TextBlock Text="100% do total" Foreground="#8B5CF6" FontSize="11"/>
                </StackPanel>
            </Border>


            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextoCard}">Administrador</TextBlock>
                    <TextBlock Style="{StaticResource NumeroCard}" Name="txtToalAlto">0</TextBlock>
                    <TextBlock Text="100% do total" Foreground="#8B5CF6" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextoCard}">Nível Medio</TextBlock>
                    <TextBlock Style="{StaticResource NumeroCard}" Name="txtTotalMedio">0</TextBlock>
                    <TextBlock Text="100% do total" Foreground="#8B5CF6" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextoCard}">Nível Baixo</TextBlock>
                    <TextBlock Style="{StaticResource NumeroCard}" Name="txtTotalBaixo">0</TextBlock>
                    <TextBlock Text="100% do total" Foreground="#8B5CF6" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextoCard}">outro nivel</TextBlock>
                    <TextBlock Style="{StaticResource NumeroCard}">0</TextBlock>
                    <TextBlock Text="100% do total" Foreground="#8B5CF6" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextoCard}">outro nivel</TextBlock>
                    <TextBlock Style="{StaticResource NumeroCard}">0</TextBlock>
                    <TextBlock Text="100% do total" Foreground="#8B5CF6" FontSize="11"/>
                </StackPanel>
            </Border>


        </UniformGrid>

        <Grid Grid.Row="2" Margin="0 0 10 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <Border Background="#11162D"
                    BorderBrush="#252B46"
                    BorderThickness="1"
                    CornerRadius="10"
                    Height="58"
                    Padding="14 0">

                <TextBox Name="txtBusca"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         TextChanged="txtBusca_TextChanged"/>

            </Border>

            <Border Grid.Column="1"
                    Margin="14 0 0 0"
                    Background="#11162D"
                    BorderBrush="#252B46"
                    BorderThickness="1"
                    CornerRadius="10"
                    Height="58"
                    Padding="12 6">

                <StackPanel>

                    <!-- TEXTO PEQUENO -->
                    <TextBlock Text="Nível de acesso"
                               Foreground="#94A3B8"
                               FontSize="11"
                               Margin="2 0 0 2"/>

                    <!-- COMBO -->
                    <ComboBox x:Name="cmbTipo"
                              Style="{StaticResource ComboBoxModerno}"
                              
                              Foreground="White"
                              FontSize="14"
                              SelectionChanged="Filtro_Changed">

                        <ComboBoxItem Content="Todos"
                          IsSelected="True"/>
                        <ComboBoxItem Content="Alto"/>
                        <ComboBoxItem Content="Medio"/>
                        <ComboBoxItem Content="Baixo"/>

                    </ComboBox>

                </StackPanel>

            </Border>

            <Border Grid.Column="2"
                    Margin="14 0 0 0"
                    Background="#11162D"
                    BorderBrush="#252B46"
                    BorderThickness="1"
                    CornerRadius="10"
                    Height="58"
                    Padding="12 6">

                <StackPanel>

                    <!-- TEXTO PEQUENO -->
                    <TextBlock Text="Status"
                               Foreground="#94A3B8"
                               FontSize="11"
                               Margin="2 0 0 2"/>

                    <!-- COMBO -->
                    <ComboBox x:Name="cmbStatus"
                              Style="{StaticResource ComboBoxModerno}"
                              
                              Foreground="White"
                              FontSize="14"
                              SelectionChanged="Filtro_Changed">

                        <ComboBoxItem Content="Todos"
                                      IsSelected="True"/>
                        <ComboBoxItem Content="Ativo"/>
                        <ComboBoxItem Content="Inativo"/>

                    </ComboBox>

                </StackPanel>

            </Border>
            
        


        <Button Grid.Column="3"
                Style="{StaticResource BotaoRoxoTelas}"
                Content="+ Novo Administrador"
                
                Margin="10" Click="Button_Click">
            </Button>

        </Grid>


        <Border Grid.Row="3"
                Background="#11162B"
                BorderBrush="#1F2942"
                BorderThickness="1"
                CornerRadius="18"
                Margin="0 0 15 0"
                Padding="14 12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0 0 0 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock Text="Lista de Administradores"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <TextBlock Text="Ordenar por:"
                                   Foreground="#CBD5E1"
                                   VerticalAlignment="Center"
                                   Margin="0 0 5 0"/>

                        <ComboBox Style="{StaticResource ComboBoxModerno}"
                                  Width="160"
                                  Height="34"
                                  Background="#0F1428"
                                  Foreground="White"
                                  BorderBrush="#252B46">

                            <ComboBoxItem Content="Mais recentes" IsSelected="True"/>
                            <ComboBoxItem Content="Mais antigos"/>
                            <ComboBoxItem Content="Nome"/>
                        </ComboBox>

                    </StackPanel>

                </Grid>

                <DataGrid Grid.Row="1"
                          Name="dgAdministradores"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="White"
                          RowHeight="50"
                          ColumnHeaderHeight="34"
                          RowBackground="Transparent"
                          AlternatingRowBackground="Transparent">




                    <DataGrid.Resources>

                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#CBD5E1"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10 0"/>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Setter Property="Margin" Value="0 0 0 4"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridRow">
                                        <Grid>
                                            <Border Background="#151B34"
                                                    BorderBrush="#252B46"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    SnapsToDevicePixels="True">

                                                <Grid>
                                                    <Border Width="3"
                                                            Background="{Binding CorPerfil}"
                                                            HorizontalAlignment="Left"
                                                            CornerRadius="8 0 0 8"/>

                                                    <SelectiveScrollingGrid Margin="6 0 0 0">
                                                        <SelectiveScrollingGrid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </SelectiveScrollingGrid.ColumnDefinitions>

                                                        <DataGridCellsPresenter Grid.Column="1"/>
                                                    </SelectiveScrollingGrid>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10 0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>

                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <!-- ADMINISTRADOR -->
                        <DataGridTemplateColumn Header="Administrador" Width="3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                        <Border Width="30"
                                                Height="30"
                                                Margin="4 0 0 0"
                                                CornerRadius="15"
                                                Background="{Binding CorPerfil}"
                                                VerticalAlignment="Center">

                                            <TextBlock Text="{Binding Iniciais}"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Margin="10 0 0 0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nome}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"/>

                                            <TextBlock Text="{Binding Email}"
                                                       Foreground="#94A3B8"
                                                       FontSize="10"/>
                                        </StackPanel>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- USUÁRIO -->
                        <DataGridTextColumn Header="Usuário"
                                            Binding="{Binding NomeUsuario}"
                                            Width="1.4*"/>

                        <!-- NÍVEL -->
                        <DataGridTemplateColumn Header="Nível" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Border CornerRadius="8"
                                            Padding="8 2"
                                            HorizontalAlignment="Left">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#2B1B57"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NivelAcesso}" Value="Alto">
                                                        <Setter Property="Background" Value="#4A1D2A"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding NivelAcesso}" Value="Medio">
                                                        <Setter Property="Background" Value="#3A2F11"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding NivelAcesso}" Value="Baixo">
                                                        <Setter Property="Background" Value="#0B2A5B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding NivelAcesso}"
                                                   FontWeight="SemiBold"
                                                   FontSize="10">

                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#A855F7"/>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NivelAcesso}" Value="Alto">
                                                            <Setter Property="Foreground" Value="#F87171"/>
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding NivelAcesso}" Value="Medio">
                                                            <Setter Property="Foreground" Value="#FACC15"/>
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding NivelAcesso}" Value="Baixo">
                                                            <Setter Property="Foreground" Value="#3B82F6"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>

                                        </TextBlock>
                                    </Border>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- STATUS -->
                        <DataGridTemplateColumn Header="Status" Width="1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Border CornerRadius="8"
                                            Padding="8 2"
                                            HorizontalAlignment="Left">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#0F3B2E"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Inativo">
                                                        <Setter Property="Background" Value="#4A1D2A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding Status}"
                                                   FontWeight="SemiBold"
                                                   FontSize="10">

                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#22C55E"/>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Inativo">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>

                                        </TextBlock>
                                    </Border>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- CADASTRO -->
                        <DataGridTextColumn Header="Cadastro"
                                            Binding="{Binding DataCadastro}"
                                            Width="1.2*"/>

                        <!-- AÇÕES -->
                        <DataGridTemplateColumn Header="Ações" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">

                                        <Button Width="34"
                                                Height="30"
                                                Background="#151A32"
                                                BorderBrush="#334155"
                                                BorderThickness="1"
                                                Margin="0 0 8 0"
                                                Click="BtnVisualizar_Click">

                                            <Icon:PackIconMaterial Kind="EyeOutline"
                                               Width="15"
                                               Height="15"
                                               Foreground="White"/>
                                        </Button>

                                        <Button Width="34"
                                                Height="30"
                                                Background="#151A32"
                                                BorderBrush="#7C3AED"
                                                BorderThickness="1"
                                                Click="BtnEditar_Click">

                                            <Icon:PackIconMaterial Kind="PencilOutline"
                                               Width="15"
                                               Height="15"
                                               Foreground="White"/>
                                        </Button>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>


                </DataGrid>



            </Grid>






        </Border>







    </Grid>
</UserControl>
