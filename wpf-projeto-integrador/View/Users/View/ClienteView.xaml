<UserControl x:Class="wpf_projeto_integrador.View.Users.View.ClienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
         Background="#0B1024">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <StackPanel>
            <TextBlock Text="Clientes"
                   FontSize="31"
                   FontWeight="Bold"
                   Foreground="White"/>

            <TextBlock Text="Visão geral dos clientes cadastrados no sistema."
                   FontSize="14"
                   Foreground="#CBD5E1"/>
        </StackPanel>

        <!-- CARDS -->
        <UniformGrid Grid.Row="1"
                 Columns="4"
                 Margin="0 18 0 10">

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextoCard}">Total de Clientes</TextBlock>
                    <TextBlock Style="{StaticResource NumeroCard}" Name="txtTotalClientes">0</TextBlock>
                    <TextBlock Text="Cadastrados no sistema" Foreground="#8B5CF6" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextoCard}">Ativos</TextBlock>
                    <TextBlock Style="{StaticResource NumeroCard}" Name="txtTotalAtivos">0</TextBlock>
                    <TextBlock Text="Clientes ativos" Foreground="#22C55E" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextoCard}">Inativos</TextBlock>
                    <TextBlock Style="{StaticResource NumeroCard}" Name="txtTotalInativos">0</TextBlock>
                    <TextBlock Text="Clientes desativados" Foreground="#EF4444" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextoCard}">Novos Clientes</TextBlock>
                    <TextBlock Style="{StaticResource NumeroCard}" Name="txtTotalNovos">0</TextBlock>
                    <TextBlock Text="Últimos 30 dias" Foreground="#38BDF8" FontSize="11"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- FILTROS -->
        <Grid Grid.Row="2" Margin="0 0 10 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <Border Background="#11162D"
                BorderBrush="#252B46"
                BorderThickness="1"
                CornerRadius="10"
                Height="58"
                Padding="14 0">

                <TextBox Name="txtBusca"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     VerticalContentAlignment="Center"
                     FontSize="14"
                     TextChanged="txtBusca_TextChanged"/>
            </Border>

            <Border Grid.Column="1"
                Margin="14 0 0 0"
                Background="#11162D"
                BorderBrush="#252B46"
                BorderThickness="1"
                CornerRadius="10"
                Height="58"
                Padding="12 6">

                <StackPanel>
                    <TextBlock Text="Status"
                           Foreground="#94A3B8"
                           FontSize="11"/>

                    <ComboBox x:Name="cmbStatus"
                          Style="{StaticResource ComboBoxModerno}"
                          Foreground="White"
                          FontSize="14"
                          SelectionChanged="Filtro_Changed">

                        <ComboBoxItem Content="Todos" IsSelected="True"/>
                        <ComboBoxItem Content="Ativo"/>
                        <ComboBoxItem Content="Inativo"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                Margin="14 0 0 0"
                Background="#11162D"
                BorderBrush="#252B46"
                BorderThickness="1"
                CornerRadius="10"
                Height="58"
                Padding="12 6">

                <StackPanel>
                    <TextBlock Text="Cidade"
                           Foreground="#94A3B8"
                           FontSize="11"/>

                    <ComboBox x:Name="cmbCidade"
                          Style="{StaticResource ComboBoxModerno}"
                          Foreground="White"
                          FontSize="14"
                          SelectionChanged="Filtro_Changed">

                        <ComboBoxItem Content="Todas" IsSelected="True"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Button Grid.Column="3"
                Style="{StaticResource BotaoRoxoTelas}"
                Content="+ Novo Cliente"
                Margin="10"
                Click="BtnNovoCliente_Click"/>
        </Grid>

        <!-- LISTA -->
        <Border Grid.Row="3"
            Background="#11162B"
            BorderBrush="#1F2942"
            BorderThickness="1"
            CornerRadius="18"
            Margin="0 0 15 0"
            Padding="14 12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Lista de Clientes"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0 0 0 10"/>

                <DataGrid Grid.Row="1"
                      Name="dgClientes"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="White"
                      RowHeight="64"
                      ColumnHeaderHeight="34"
                      RowBackground="Transparent"
                      AlternatingRowBackground="Transparent">

                    <DataGrid.Resources>

                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#CBD5E1"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10 0"/>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Setter Property="Margin" Value="0 0 0 4"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridRow">
                                        <Grid>
                                            <Border Background="#151B34"
                                                BorderBrush="#252B46"
                                                BorderThickness="1"
                                                CornerRadius="8">

                                                <Grid>
                                                    <Border Width="3"
                                                        Background="{Binding CorPerfil}"
                                                        HorizontalAlignment="Left"
                                                        CornerRadius="8 0 0 8"/>

                                                    <SelectiveScrollingGrid Margin="6 0 0 0">
                                                        <SelectiveScrollingGrid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </SelectiveScrollingGrid.ColumnDefinitions>

                                                        <DataGridCellsPresenter Grid.Column="1"/>
                                                    </SelectiveScrollingGrid>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10 0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>

                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="Cliente" Width="3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                        <Border Width="38"
                                            Height="38"
                                            CornerRadius="19"
                                            Background="{Binding CorPerfil}">

                                            <TextBlock Text="{Binding Iniciais}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Margin="10 0 0 0">
                                            <TextBlock Text="{Binding Nome}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"/>

                                            <TextBlock Text="{Binding Email}"
                                                   Foreground="#94A3B8"
                                                   FontSize="11"/>
                                        </StackPanel>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Usuário"
                                        Binding="{Binding NomeUsuario}"
                                        Width="1.3*"/>

                        <DataGridTextColumn Header="Telefone"
                                        Binding="{Binding Telefone}"
                                        Width="1.4*"/>

                        <DataGridTextColumn Header="Cidade"
                                        Binding="{Binding Cidade}"
                                        Width="1.4*"/>

                        <DataGridTemplateColumn Header="Status" Width="1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8"
                                        Padding="8 2"
                                        HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#0F3B2E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Inativo">
                                                        <Setter Property="Background" Value="#4A1D2A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding Status}"
                                               FontWeight="SemiBold"
                                               FontSize="10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#22C55E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Inativo">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Cadastro"
                                        Binding="{Binding DataCriacao}"
                                        Width="1.2*"/>

                        <DataGridTemplateColumn Header="Ações" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">

                                        <Button Width="34"
                                            Height="30"
                                            Background="#151A32"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Margin="0 0 8 0"
                                            Click="BtnVisualizar_Click">

                                            <Icon:PackIconMaterial Kind="EyeOutline"
                                                               Width="15"
                                                               Height="15"
                                                               Foreground="White"/>
                                        </Button>

                                        <Button Width="34"
                                            Height="30"
                                            Background="#151A32"
                                            BorderBrush="#7C3AED"
                                            BorderThickness="1"
                                            Click="BtnEditar_Click">

                                            <Icon:PackIconMaterial Kind="PencilOutline"
                                                               Width="15"
                                                               Height="15"
                                                               Foreground="White"/>
                                        </Button>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
