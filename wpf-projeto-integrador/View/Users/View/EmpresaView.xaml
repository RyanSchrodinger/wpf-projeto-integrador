<UserControl x:Class="wpf_projeto_integrador.View.Users.View.EmpresaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
         Background="#0B1024">

<Grid Margin="22">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- TÍTULO -->
    <StackPanel>
        <TextBlock Text="Empresas"
                   FontSize="31"
                   FontWeight="Bold"
                   Foreground="White"/>

        <TextBlock Text="Visão geral das empresas cadastradas no sistema."
                   FontSize="14"
                   Foreground="#CBD5E1"/>
    </StackPanel>

    <!-- CARDS -->
    <UniformGrid Grid.Row="1"
                 Columns="4"
                 Margin="0 18 0 10">

        <Border Style="{StaticResource CardResumo}">
            <StackPanel>
                <TextBlock Style="{StaticResource TextoCard}">Total de Empresas</TextBlock>
                <TextBlock Style="{StaticResource NumeroCard}" Name="txtTotalEmpresas">0</TextBlock>
                <TextBlock Text="Empresas cadastradas" Foreground="#8B5CF6" FontSize="11"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardResumo}">
            <StackPanel>
                <TextBlock Style="{StaticResource TextoCard}">Ativas</TextBlock>
                <TextBlock Style="{StaticResource NumeroCard}" Name="txtTotalAtivas">0</TextBlock>
                <TextBlock Text="Em funcionamento" Foreground="#22C55E" FontSize="11"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardResumo}">
            <StackPanel>
                <TextBlock Style="{StaticResource TextoCard}">Com Profissionais</TextBlock>
                <TextBlock Style="{StaticResource NumeroCard}" Name="txtComProfissionais">0</TextBlock>
                <TextBlock Text="Possuem colaboradores" Foreground="#38BDF8" FontSize="11"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardResumo}">
            <StackPanel>
                <TextBlock Style="{StaticResource TextoCard}">Sem Profissionais</TextBlock>
                <TextBlock Style="{StaticResource NumeroCard}" Name="txtSemProfissionais">0</TextBlock>
                <TextBlock Text="Sem colaboradores" Foreground="#FACC15" FontSize="11"/>
            </StackPanel>
        </Border>

    </UniformGrid>

    <!-- FILTROS -->
    <Grid Grid.Row="2" Margin="0 0 10 10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <Border Background="#11162D"
                BorderBrush="#252B46"
                BorderThickness="1"
                CornerRadius="10"
                Height="58"
                Padding="14 0">

            <TextBox Name="txtBusca"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     VerticalContentAlignment="Center"
                     FontSize="14"
                     TextChanged="txtBusca_TextChanged"/>
        </Border>

        <Border Grid.Column="1"
                Margin="14 0 0 0"
                Background="#11162D"
                BorderBrush="#252B46"
                BorderThickness="1"
                CornerRadius="10"
                Height="58"
                Padding="12 6">

            <StackPanel>
                <TextBlock Text="Profissionais"
                           Foreground="#94A3B8"
                           FontSize="11"/>

                <ComboBox x:Name="cmbProfissionais"
                          Style="{StaticResource ComboBoxModerno}"
                          Foreground="White"
                          FontSize="14"
                          SelectionChanged="Filtro_Changed">

                    <ComboBoxItem Content="Todas" IsSelected="True"/>
                    <ComboBoxItem Content="Com Profissionais"/>
                    <ComboBoxItem Content="Sem Profissionais"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <Border Grid.Column="2"
                Margin="14 0 0 0"
                Background="#11162D"
                BorderBrush="#252B46"
                BorderThickness="1"
                CornerRadius="10"
                Height="58"
                Padding="12 6">

            <StackPanel>
                <TextBlock Text="Status"
                           Foreground="#94A3B8"
                           FontSize="11"/>

                <ComboBox x:Name="cmbStatus"
                          Style="{StaticResource ComboBoxModerno}"
                          Foreground="White"
                          FontSize="14"
                          SelectionChanged="Filtro_Changed">

                    <ComboBoxItem Content="Todos" IsSelected="True"/>
                    <ComboBoxItem Content="Ativa"/>
                    <ComboBoxItem Content="Inativa"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <Button Grid.Column="3"
                Style="{StaticResource BotaoRoxoTelas}"
                Content="+ Nova Empresa"
                Margin="10"
                Click="BtnNovaEmpresa_Click"/>
    </Grid>

    <!-- LISTA -->
    <Border Grid.Row="3"
            Background="#11162B"
            BorderBrush="#1F2942"
            BorderThickness="1"
            CornerRadius="18"
            Margin="0 0 15 0"
            Padding="14 12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Lista de Empresas"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0 0 0 10"/>

            <DataGrid Grid.Row="1"
                      Name="dgEmpresas"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="White"
                      RowHeight="64"
                      ColumnHeaderHeight="34"
                      RowBackground="Transparent"
                      AlternatingRowBackground="Transparent">

                <DataGrid.Resources>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#CBD5E1"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10 0"/>
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Setter Property="Margin" Value="0 0 0 4"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridRow">
                                    <Grid>
                                        <Border Background="#151B34"
                                                BorderBrush="#252B46"
                                                BorderThickness="1"
                                                CornerRadius="8">

                                            <Grid>
                                                <Border Width="3"
                                                        Background="{Binding CorPerfil}"
                                                        HorizontalAlignment="Left"
                                                        CornerRadius="8 0 0 8"/>

                                                <SelectiveScrollingGrid Margin="6 0 0 0">
                                                    <SelectiveScrollingGrid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </SelectiveScrollingGrid.ColumnDefinitions>

                                                    <DataGridCellsPresenter Grid.Column="1"/>
                                                </SelectiveScrollingGrid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10 0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>

                </DataGrid.Resources>

                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="Empresa" Width="2.4*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <Border Width="38"
                                            Height="38"
                                            CornerRadius="19"
                                            Background="{Binding CorPerfil}">

                                        <TextBlock Text="{Binding Iniciais}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Margin="10 0 0 0">
                                        <TextBlock Text="{Binding NomeFantasia}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"/>

                                        <TextBlock Text="{Binding Email}"
                                                   Foreground="#94A3B8"
                                                   FontSize="11"/>
                                    </StackPanel>

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="CNPJ"
                                        Binding="{Binding Cnpj}"
                                        Width="1.5*"/>

                    <DataGridTextColumn Header="Responsável"
                                        Binding="{Binding Responsavel}"
                                        Width="1.5*"/>

                    <DataGridTextColumn Header="Telefone"
                                        Binding="{Binding Telefone}"
                                        Width="1.3*"/>

                    <DataGridTemplateColumn Header="Profissionais" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#1E1B4B"
                                        CornerRadius="8"
                                        Padding="8 2"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding TotalProfissionais}"
                                               Foreground="#A855F7"
                                               FontWeight="SemiBold"
                                               FontSize="10"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Status" Width="1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8"
                                        Padding="8 2"
                                        HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#0F3B2E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Inativa">
                                                    <Setter Property="Background" Value="#4A1D2A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding Status}"
                                               FontWeight="SemiBold"
                                               FontSize="10">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#22C55E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Inativa">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Cadastro"
                                        Binding="{Binding DataCadastro}"
                                        Width="1.1*"/>

                    <DataGridTemplateColumn Header="Ações" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">

                                    <!-- VER EMPRESA -->
                                    <Button Width="34"
                                            Height="30"
                                            Background="#151A32"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Margin="0 0 8 0"
                                            Click="BtnVisualizar_Click">

                                        <Icon:PackIconMaterial Kind="EyeOutline"
                                                               Width="15"
                                                               Height="15"
                                                               Foreground="White"/>
                                    </Button>

                                    <!-- EDITAR -->
                                    <Button Width="34"
                                            Height="30"
                                            Background="#151A32"
                                            BorderBrush="#7C3AED"
                                            BorderThickness="1"
                                            Margin="0 0 8 0"
                                            Click="BtnEditar_Click">

                                        <Icon:PackIconMaterial Kind="PencilOutline"
                                                               Width="15"
                                                               Height="15"
                                                               Foreground="White"/>
                                    </Button>

                                    <!-- VER PROFISSIONAIS -->
                                    <Button Width="34"
                                            Height="30"
                                            Background="#151A32"
                                            BorderBrush="#38BDF8"
                                            BorderThickness="1"
                                            Click="BtnProfissionais_Click">

                                        <Icon:PackIconMaterial Kind="AccountGroupOutline"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="White"/>
                                    </Button>

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>

    <!-- PAINEL DE PROFISSIONAIS DA EMPRESA -->
    <Grid x:Name="PainelProfissionais"
          Grid.RowSpan="4"
          Background="#99000000"
          Visibility="Collapsed">

        <Border Width="430"
                Background="#11162B"
                BorderBrush="#252B46"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20"
                HorizontalAlignment="Right"
                Margin="0 0 15 0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Profissionais da Empresa"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="txtNomeEmpresaSelecionada"
                                   Text="Music House"
                                   Foreground="#A78BFA"
                                   FontSize="14"
                                   Margin="0 3 0 0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="34"
                            Height="34"
                            Background="#151A32"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            Click="BtnFecharProfissionais_Click">

                        <Icon:PackIconMaterial Kind="Close"
                                               Width="16"
                                               Height="16"
                                               Foreground="White"/>
                    </Button>
                </Grid>

                <Border Grid.Row="1"
                        Background="#151B34"
                        BorderBrush="#252B46"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0 18 0 14">

                    <StackPanel Orientation="Horizontal">
                        <Icon:PackIconMaterial Kind="AccountGroupOutline"
                                               Width="20"
                                               Height="20"
                                               Foreground="#8B5CF6"
                                               Margin="0 0 8 0"/>

                        <TextBlock Text="Total de profissionais vinculados: "
                                   Foreground="#CBD5E1"
                                   FontSize="13"/>

                        <TextBlock x:Name="txtTotalProfissionaisEmpresa"
                                   Text="0"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="13"/>
                    </StackPanel>
                </Border>

                <ListBox Grid.Row="2"
                         x:Name="lstProfissionaisEmpresa"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#151B34"
                                    BorderBrush="#252B46"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0 0 0 8">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="42"
                                            Height="42"
                                            CornerRadius="21"
                                            Background="{Binding CorPerfil}"
                                            VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Iniciais}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="12 0 0 0"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Nome}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"/>

                                        <TextBlock Text="{Binding Especialidade}"
                                                   Foreground="#A78BFA"
                                                   FontSize="12"/>

                                        <TextBlock Text="{Binding Email}"
                                                   Foreground="#94A3B8"
                                                   FontSize="11"/>
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            CornerRadius="8"
                                            Padding="8 2"
                                            VerticalAlignment="Center">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#0F3B2E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Inativo">
                                                        <Setter Property="Background" Value="#4A1D2A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding Status}"
                                                   FontWeight="SemiBold"
                                                   FontSize="10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#22C55E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Inativo">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="3"
                        Content="Fechar"
                        Style="{StaticResource BotaoRoxoTelas}"
                        Height="44"
                        Margin="0 15 0 0"
                        Click="BtnFecharProfissionais_Click"/>
            </Grid>
        </Border>
    </Grid>

</Grid>
</UserControl>
