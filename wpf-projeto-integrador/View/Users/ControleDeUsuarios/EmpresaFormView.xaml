<UserControl x:Class="wpf_projeto_integrador.View.Users.ControleDeUsuarios.EmpresaFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="#0B1024">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOPO -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Width="46"
                Height="46"
                Style="{StaticResource BotaoSecundario}"
                Click="BtnVoltar_Click">

                <Icon:PackIconMaterial Kind="ArrowLeft"
                                   Width="22"
                                   Height="22"
                                   Foreground="White"/>
            </Button>

            <StackPanel Grid.Column="1" Margin="16 0 0 0">
                <TextBlock x:Name="txtTitulo"
                       Text="Empresa"
                       Foreground="White"
                       FontSize="34"
                       FontWeight="Bold"/>

                <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                    <TextBlock Text="Empresas" Foreground="#94A3B8"/>
                    <TextBlock Text="  ›  " Foreground="#64748B"/>
                    <TextBlock x:Name="txtModo" Text="Cadastro" Foreground="#CBD5E1"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="2"
                Background="#2B1B57"
                BorderBrush="#7C3AED"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18 10"
                VerticalAlignment="Top">

                <StackPanel Orientation="Horizontal">
                    <Icon:PackIconMaterial Kind="OfficeBuilding"
                                       Width="20"
                                       Height="20"
                                       Foreground="#A855F7"
                                       Margin="0 0 8 0"/>

                    <TextBlock Text="Gerenciamento de empresa"
                           Foreground="#C084FC"
                           FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- CARD FORM -->
        <Border Grid.Row="1"
            Margin="0 28 0 0"
            Background="#11162B"
            BorderBrush="#1F2942"
            BorderThickness="1"
            CornerRadius="18"
            Padding="34">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0 0 0 28">
                    <Icon:PackIconMaterial Kind="OfficeBuilding"
                                       Width="22"
                                       Height="22"
                                       Foreground="#8B5CF6"
                                       Margin="0 0 10 0"/>

                    <TextBlock Text="Dados da empresa"
                           Foreground="White"
                           FontSize="17"
                           FontWeight="SemiBold"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                    <Grid Margin="0 0 8 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- RAZÃO SOCIAL -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Razão social *" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource InputBox}">
                                <TextBox x:Name="txtNome" Style="{StaticResource TextBoxCampo}"/>
                            </Border>
                        </StackPanel>

                        <!-- NOME FANTASIA -->
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Nome fantasia *" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource InputBox}">
                                <TextBox x:Name="txtNomeFantasia" Style="{StaticResource TextBoxCampo}"/>
                            </Border>
                        </StackPanel>

                        <!-- CNPJ -->
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="CNPJ *" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource InputBox}">
                                <TextBox x:Name="txtCnpj" Style="{StaticResource TextBoxCampo}"/>
                            </Border>
                        </StackPanel>

                        <!-- RESPONSÁVEL -->
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Responsável" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource InputBox}">
                                <TextBox x:Name="txtResponsavel" Style="{StaticResource TextBoxCampo}"/>
                            </Border>
                        </StackPanel>

                        <!-- EMAIL -->
                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="E-mail *" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource InputBox}">
                                <TextBox x:Name="txtEmail" Style="{StaticResource TextBoxCampo}"/>
                            </Border>
                        </StackPanel>

                        <!-- USUÁRIO -->
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="Nome de usuário *" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource InputBox}">
                                <TextBox x:Name="txtNomeUsuario" Style="{StaticResource TextBoxCampo}"/>
                            </Border>
                        </StackPanel>

                        <!-- SENHA -->
                        <StackPanel Grid.Row="6" Grid.Column="0">
                            <TextBlock Text="Senha *" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource InputBox}">
                                <PasswordBox x:Name="txtSenha"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="White"
                                         FontSize="14"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- TELEFONE -->
                        <StackPanel Grid.Row="6" Grid.Column="2">
                            <TextBlock Text="Telefone" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource InputBox}">
                                <TextBox x:Name="txtTelefone" Style="{StaticResource TextBoxCampo}"/>
                            </Border>
                        </StackPanel>

                        <!-- DATA -->
                        <StackPanel Grid.Row="8" Grid.Column="0">
                            <TextBlock Text="Data de cadastro" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource InputBox}" Opacity="0.65">
                                <TextBox x:Name="txtDataCadastro"
                                     Style="{StaticResource TextBoxCampo}"
                                     IsReadOnly="True"/>
                            </Border>
                        </StackPanel>

                        <!-- ENDEREÇO -->
                        <StackPanel Grid.Row="8" Grid.Column="2">
                            <TextBlock Text="Endereço" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource InputBox}">
                                <TextBox x:Name="txtEndereco" Style="{StaticResource TextBoxCampo}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- BOTÕES -->
                <Grid Grid.Row="2" Margin="0 30 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                        Content="Cancelar"
                        Style="{StaticResource BotaoSecundario}"
                        Click="BtnCancelar_Click"/>

                    <Button x:Name="btnDesativar"
                        Grid.Column="2"
                        Style="{StaticResource BotaoDesativar}"
                        Click="BtnDesativar_Click">

                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial x:Name="iconBotaoDesativar"
                                               Kind="OfficeBuildingRemove"
                                               Width="20"
                                               Height="20"
                                               Foreground="#F87171"
                                               Margin="0 0 8 0"/>

                            <TextBlock x:Name="txtBotaoDesativar"
                                   Text="Desativar empresa"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4"
                        Style="{StaticResource BotaoSalvar}"
                        Click="BtnSalvar_Click">

                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="ContentSaveOutline"
                                               Width="20"
                                               Height="20"
                                               Foreground="White"
                                               Margin="0 0 8 0"/>

                            <TextBlock x:Name="btnSalvar" Text="Salvar alterações"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

    
    