<UserControl x:Class="wpf_projeto_integrador.View.Users.ControleDeUsuarios.AdministradorFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="#0B1024">

    <UserControl.Resources>

        <Style x:Key="InputBox" TargetType="Border">
            <Setter Property="Background" Value="#11162D"/>
            <Setter Property="BorderBrush" Value="#252B46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="14 0"/>
        </Style>

        <Style x:Key="LabelCampo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0 0 0 7"/>
        </Style>

        <Style x:Key="TextBoxCampo" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ComboCampo" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BotaoSalvar" TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="BotaoSecundario" TargetType="Button">
            <Setter Property="Background" Value="#11162D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#252B46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="BotaoDesativar" TargetType="Button">
            <Setter Property="Background" Value="#2A1320"/>
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="BorderBrush" Value="#EF4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOPO -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Width="46"
                    Height="46"
                    Style="{StaticResource BotaoSecundario}"
                    Click="BtnVoltar_Click">

                <Icon:PackIconMaterial Kind="ArrowLeft"
                                       Width="22"
                                       Height="22"
                                       Foreground="White"/>
            </Button>

            <StackPanel Grid.Column="1"
                        Margin="16 0 0 0">

                <TextBlock x:Name="txtTitulo"
                           Text="Administrador"
                           Foreground="White"
                           FontSize="34"
                           FontWeight="Bold"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0 4 0 0">

                    <TextBlock Text="Administradores"
                               Foreground="#94A3B8"/>

                    <TextBlock Text="  ›  "
                               Foreground="#64748B"/>

                    <TextBlock x:Name="txtModo"
                               Text="Cadastro"
                               Foreground="#CBD5E1"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="2"
                    Background="#2B1B57"
                    BorderBrush="#7C3AED"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18 10"
                    VerticalAlignment="Top">

                <StackPanel Orientation="Horizontal">
                    <Icon:PackIconMaterial Kind="ShieldAccount"
                                           Width="20"
                                           Height="20"
                                           Foreground="#A855F7"
                                           Margin="0 0 8 0"/>

                    <TextBlock x:Name="txtNivelTopo"
                               Text="Nível Alto"
                               Foreground="#C084FC"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- CARD FORM -->
        <Border Grid.Row="1"
                Margin="0 28 0 0"
                Background="#11162B"
                BorderBrush="#1F2942"
                BorderThickness="1"
                CornerRadius="18"
                Padding="34">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ABAS VISUAIS -->
                <StackPanel Orientation="Horizontal"
                            Margin="0 0 0 28">

                    <StackPanel Orientation="Horizontal">
                        <Icon:PackIconMaterial Kind="AccountCog"
                                               Width="22"
                                               Height="22"
                                               Foreground="#8B5CF6"
                                               Margin="0 0 10 0"/>

                        <TextBlock Text="Dados do administrador"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <Border Width="250"
                            Height="3"
                            Background="#8B5CF6"
                            VerticalAlignment="Bottom"
                            Margin="-245 36 0 0"/>
                </StackPanel>

                <!-- CAMPOS -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- NOME -->
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Nome completo *" Style="{StaticResource LabelCampo}"/>
                        <Border Style="{StaticResource InputBox}">
                            <TextBox x:Name="txtNome" Style="{StaticResource TextBoxCampo}"/>
                        </Border>
                    </StackPanel>

                    <!-- EMAIL -->
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="E-mail *" Style="{StaticResource LabelCampo}"/>
                        <Border Style="{StaticResource InputBox}">
                            <TextBox x:Name="txtEmail" Style="{StaticResource TextBoxCampo}"/>
                        </Border>
                    </StackPanel>

                    <!-- USUÁRIO -->
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Nome de usuário *" Style="{StaticResource LabelCampo}"/>
                        <Border Style="{StaticResource InputBox}">
                            <TextBox x:Name="txtNomeUsuario" Style="{StaticResource TextBoxCampo}"/>
                        </Border>
                    </StackPanel>

                    <!-- SENHA -->
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Senha *" Style="{StaticResource LabelCampo}"/>
                        <Border Style="{StaticResource InputBox}">
                            <Grid>
                                <PasswordBox x:Name="txtSenha"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="White"
                                             FontSize="14"
                                             VerticalContentAlignment="Center"/>

                                <Icon:PackIconMaterial Kind="EyeOutline"
                                                       Width="20"
                                                       Height="20"
                                                       Foreground="#94A3B8"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- NIVEL -->
                    <StackPanel Grid.Row="4" Grid.Column="0">
                        <TextBlock Text="Nível de acesso *" Style="{StaticResource LabelCampo}"/>
                        <Border Style="{StaticResource InputBox}">
                            <ComboBox x:Name="cmbNivel"
                                      Style="{StaticResource ComboBoxModerno}"
                                      BorderThickness="0"
                                      Background="Transparent">
                                <ComboBoxItem Content="AdministradorGeral"/>
                                <ComboBoxItem Content="Atendente"/>
                                <ComboBoxItem Content="Suporte"/>
                                <ComboBoxItem Content="Financeiro"/>
                                <ComboBoxItem Content="Moderador"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>

                    <!-- STATUS -->
                    <StackPanel Grid.Row="4" Grid.Column="2">
                        <TextBlock Text="Status *" Style="{StaticResource LabelCampo}"/>
                        <Border Style="{StaticResource InputBox}">
                            <ComboBox x:Name="cmbStatus"
                                      Style="{StaticResource ComboBoxModerno}"
                                      BorderThickness="0"
                                      Background="Transparent">
                                <ComboBoxItem Content="Ativo"/>
                                <ComboBoxItem Content="Inativo"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>

                    <!-- TELEFONE -->
                    <StackPanel Grid.Row="6" Grid.Column="0">
                        <TextBlock Text="Telefone" Style="{StaticResource LabelCampo}"/>
                        <Border Style="{StaticResource InputBox}">
                            <TextBox x:Name="txtTelefone" Style="{StaticResource TextBoxCampo}"/>
                        </Border>
                    </StackPanel>

                    <!-- DATA -->
                    <StackPanel Grid.Row="6" Grid.Column="2">
                        <TextBlock Text="Data de cadastro" Style="{StaticResource LabelCampo}"/>
                        <Border Style="{StaticResource InputBox}" Opacity="0.65">
                            <Grid>
                                <Icon:PackIconMaterial Kind="Calendar"
                                                       Width="18"
                                                       Height="18"
                                                       Foreground="#94A3B8"
                                                       VerticalAlignment="Center"/>

                                <TextBox x:Name="txtDataCadastro"
                                         Margin="30 0 0 0"
                                         IsReadOnly="True"
                                         Style="{StaticResource TextBoxCampo}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- OBSERVAÇÃO -->
                    <StackPanel Grid.Row="8"
                                Grid.Column="0"
                                Grid.ColumnSpan="3">

                        <TextBlock Text="Observações"
                                   Style="{StaticResource LabelCampo}"/>

                        <Border Background="#11162D"
                                BorderBrush="#252B46"
                                BorderThickness="1"
                                CornerRadius="10"
                                Height="110"
                                Padding="14">

                            <TextBox x:Name="txtObservacao"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     CaretBrush="White"
                                     FontSize="14"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- BOTÕES -->
                <Grid Grid.Row="2"
                      Margin="0 30 0 0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Cancelar"
                            Style="{StaticResource BotaoSecundario}"
                            Click="BtnCancelar_Click"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource BotaoDesativar}"
                            Click="BtnDesativar_Click">

                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="AccountOff"
                                                   Width="20"
                                                   Height="20"
                                                   Foreground="#F87171"
                                                   Margin="0 0 8 0"/>

                            <TextBlock Text="Desativar conta"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4"
                            Style="{StaticResource BotaoSalvar}"
                            Click="BtnSalvar_Click">

                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="ContentSaveOutline"
                                                   Width="20"
                                                   Height="20"
                                                   Foreground="White"
                                                   Margin="0 0 8 0"/>

                            <TextBlock Text="Salvar alterações"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>