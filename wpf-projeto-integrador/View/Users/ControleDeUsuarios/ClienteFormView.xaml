<UserControl x:Class="wpf_projeto_integrador.View.Users.ControleDeUsuarios.ClienteFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="#0B1024">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOPO -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Width="46"
                    Height="46"
                    Style="{StaticResource BotaoSecundario}"
                    Click="BtnVoltar_Click">

                <Icon:PackIconMaterial Kind="ArrowLeft"
                                       Width="22"
                                       Height="22"
                                       Foreground="White"/>
            </Button>

            <StackPanel Grid.Column="1" Margin="16 0 0 0">
                <TextBlock x:Name="txtTitulo"
                           Text="Cliente"
                           Foreground="White"
                           FontSize="34"
                           FontWeight="Bold"/>

                <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                    <TextBlock Text="Clientes" Foreground="#94A3B8"/>
                    <TextBlock Text="  ›  " Foreground="#64748B"/>
                    <TextBlock x:Name="txtModo" Text="Cadastro" Foreground="#CBD5E1"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="2"
                    Background="#2B1B57"
                    BorderBrush="#7C3AED"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18 10"
                    VerticalAlignment="Top">

                <StackPanel Orientation="Horizontal">
                    <Icon:PackIconMaterial Kind="Account"
                                           Width="20"
                                           Height="20"
                                           Foreground="#A855F7"
                                           Margin="0 0 8 0"/>

                    <TextBlock Text="Gerenciamento de cliente"
                               Foreground="#C084FC"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- CARD FORM -->
        <Border Grid.Row="1"
                Margin="0 28 0 0"
                Background="#11162B"
                BorderBrush="#1F2942"
                BorderThickness="1"
                CornerRadius="18"
                Padding="34">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0 0 0 28">
                    <Icon:PackIconMaterial Kind="Account"
                                           Width="22"
                                           Height="22"
                                           Foreground="#8B5CF6"
                                           Margin="0 0 10 0"/>

                    <TextBlock Text="Dados do cliente"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <Grid Margin="0 0 8 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- NOME -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Nome completo *" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource InputBox}">
                                <TextBox x:Name="txtNome" Style="{StaticResource TextBoxCampo}"/>
                            </Border>
                        </StackPanel>

                        <!-- EMAIL -->
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="E-mail *" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource InputBox}">
                                <TextBox x:Name="txtEmail" Style="{StaticResource TextBoxCampo}"/>
                            </Border>
                        </StackPanel>

                        <!-- USUÁRIO -->
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Nome de usuário *" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource InputBox}">
                                <TextBox x:Name="txtNomeUsuario" Style="{StaticResource TextBoxCampo}"/>
                            </Border>
                        </StackPanel>

                        <!-- SENHA -->
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Senha *" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource InputBox}">
                                <Grid>
                                    <PasswordBox x:Name="txtSenha"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="White"
                                                 FontSize="14"
                                                 VerticalContentAlignment="Center"/>

                                    <Icon:PackIconMaterial Kind="EyeOutline"
                                                           Width="20"
                                                           Height="20"
                                                           Foreground="#94A3B8"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- TELEFONE -->
                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="Telefone" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource InputBox}">
                                <TextBox x:Name="txtTelefone" Style="{StaticResource TextBoxCampo}"/>
                            </Border>
                        </StackPanel>

                        <!-- STATUS -->
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="Status" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource InputBox}">
                                <ComboBox x:Name="cmbStatus"
                                          Style="{StaticResource ComboBoxModerno}"
                                          BorderThickness="0"
                                          Background="Transparent">
                                    <ComboBoxItem Content="Ativo"/>
                                    <ComboBoxItem Content="Inativo"/>
                                </ComboBox>
                            </Border>
                        </StackPanel>

                        <!-- DATA -->
                        <StackPanel Grid.Row="6" Grid.Column="0">
                            <TextBlock Text="Data de cadastro" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource InputBox}" Opacity="0.65">
                                <Grid>
                                    <Icon:PackIconMaterial Kind="Calendar"
                                                           Width="18"
                                                           Height="18"
                                                           Foreground="#94A3B8"
                                                           VerticalAlignment="Center"/>

                                    <TextBox x:Name="txtDataCadastro"
                                             Margin="30 0 0 0"
                                             Style="{StaticResource TextBoxCampo}"
                                             IsReadOnly="True"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- RUA -->
                        <StackPanel Grid.Row="6" Grid.Column="2">
                            <TextBlock Text="Rua" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource InputBox}">
                                <TextBox x:Name="txtRua" Style="{StaticResource TextBoxCampo}"/>
                            </Border>
                        </StackPanel>

                        <!-- NÚMERO -->
                        <StackPanel Grid.Row="8" Grid.Column="0">
                            <TextBlock Text="Número" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource InputBox}">
                                <TextBox x:Name="txtNumero" Style="{StaticResource TextBoxCampo}"/>
                            </Border>
                        </StackPanel>

                        <!-- CIDADE -->
                        <StackPanel Grid.Row="8" Grid.Column="2">
                            <TextBlock Text="Cidade" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource InputBox}">
                                <TextBox x:Name="txtCidade" Style="{StaticResource TextBoxCampo}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- BOTÕES -->
                <Grid Grid.Row="2" Margin="0 30 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Cancelar"
                            Style="{StaticResource BotaoSecundario}"
                            Click="BtnCancelar_Click"/>

                    <Button x:Name="btnDesativar"
                            Grid.Column="2"
                            Style="{StaticResource BotaoDesativar}"
                            Click="BtnDesativar_Click">

                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial x:Name="iconBotaoDesativar"
                                                   Kind="AccountOff"
                                                   Width="20"
                                                   Height="20"
                                                   Foreground="#F87171"
                                                   Margin="0 0 8 0"/>

                            <TextBlock x:Name="txtBotaoDesativar"
                                       Text="Desativar conta"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4"
                            Style="{StaticResource BotaoSalvar}"
                            Click="BtnSalvar_Click">

                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="ContentSaveOutline"
                                                   Width="20"
                                                   Height="20"
                                                   Foreground="White"
                                                   Margin="0 0 8 0"/>

                            <TextBlock x:Name="btnSalvar" Text="Salvar alterações"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>