<UserControl x:Class="wpf_projeto_integrador.View.Demais.DashBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#0B1024">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <StackPanel>
            <TextBlock Text="Dashboard"
                   FontSize="34"
                   FontWeight="Bold"
                   Foreground="White"/>

            <TextBlock Text="Visão geral do sistema Music Station."
                   FontSize="14"
                   Foreground="#CBD5E1"/>
        </StackPanel>

        <!-- CARDS -->
        <UniformGrid Grid.Row="1"
                 Columns="4"
                 Margin="0 22 0 18">

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <Icon:PackIconMaterial Kind="AccountGroup"
                                       Width="26"
                                       Height="26"
                                       Foreground="#8B5CF6"/>
                    <TextBlock Text="Usuários" Style="{StaticResource TextoCard}" Margin="0 10 0 0"/>
                    <TextBlock x:Name="txtTotalUsuarios" Text="0" Style="{StaticResource NumeroCard}"/>
                    <TextBlock Text="Contas cadastradas" Foreground="#8B5CF6" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <Icon:PackIconMaterial Kind="OfficeBuilding"
                                       Width="26"
                                       Height="26"
                                       Foreground="#38BDF8"/>
                    <TextBlock Text="Empresas" Style="{StaticResource TextoCard}" Margin="0 10 0 0"/>
                    <TextBlock x:Name="txtTotalEmpresas" Text="0" Style="{StaticResource NumeroCard}"/>
                    <TextBlock Text="Empresas no sistema" Foreground="#38BDF8" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <Icon:PackIconMaterial Kind="AccountMusic"
                                       Width="26"
                                       Height="26"
                                       Foreground="#22C55E"/>
                    <TextBlock Text="Profissionais" Style="{StaticResource TextoCard}" Margin="0 10 0 0"/>
                    <TextBlock x:Name="txtTotalProfissionais" Text="0" Style="{StaticResource NumeroCard}"/>
                    <TextBlock Text="Prestadores ativos" Foreground="#22C55E" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <Icon:PackIconMaterial Kind="ClipboardText"
                                       Width="26"
                                       Height="26"
                                       Foreground="#FACC15"/>
                    <TextBlock Text="Logs" Style="{StaticResource TextoCard}" Margin="0 10 0 0"/>
                    <TextBlock x:Name="txtTotalLogs" Text="0" Style="{StaticResource NumeroCard}"/>
                    <TextBlock Text="Registros no sistema" Foreground="#FACC15" FontSize="11"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- CONTEÚDO -->

    </Grid>
</UserControl>
