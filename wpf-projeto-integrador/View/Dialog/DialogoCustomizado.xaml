<Window x:Class="wpf_projeto_integrador.View.Dialog.DialogoCustomizado"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight">

    <Border Background="#111827"
        CornerRadius="18"
        Padding="24"
        BorderBrush="#2A3346"
        BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Width="42"
                    Height="42"
                    CornerRadius="21"
                    Background="#312E81"
                    Margin="0,0,14,0">
                    <TextBlock Text="!"
                           Foreground="#A5B4FC"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="TxtTitulo"
                       Grid.Column="1"
                       Text="Erro"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            </Grid>

            <!-- Linha -->
            <Border Grid.Row="1"
                Background="#253044"
                Height="1"/>

            <!-- Conteúdo -->
            <ContentControl x:Name="DialogContent"
                        Grid.Row="2"
                        Margin="0,18,0,22"/>

            <!-- Botão -->
            <Button x:Name="BtnOk"
                Grid.Row="3"
                Content="OK"
                Width="140"
                Height="42"
                HorizontalAlignment="Right"
                Background="#5865F2"
                Foreground="White"
                BorderThickness="0"
                FontWeight="SemiBold"
                Cursor="Hand"
                Click="BtnOk_Click"/>
        </Grid>
    </Border>   
</Window>
