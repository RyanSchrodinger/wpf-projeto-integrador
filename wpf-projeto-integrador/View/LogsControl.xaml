<UserControl x:Class="wpf_projeto_integrador.View.LogsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200">

    <Grid Background="#0F0F1A">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#171726"
                CornerRadius="22"
                Padding="24"
                Margin="20 20 20 12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="70"
                        Height="70"
                        CornerRadius="35"
                        Background="#6D28D9">

                    <iconPacks:PackIconMaterial Kind="ClipboardTextClock"
                                                Width="34"
                                                Height="34"
                                                Foreground="White"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="18 0 0 0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Logs do Sistema"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"/>

                    <TextBlock Text="Monitore atividades, acessos, erros e ações administrativas"
                               Foreground="#9CA3AF"
                               FontSize="14"
                               Margin="0 6 0 0"/>
                </StackPanel>

                <!-- CARD TOTAL -->
                <Border Grid.Column="2"
                        Background="#0F0F1A"
                        CornerRadius="16"
                        Padding="18 12"
                        Margin="10 0 0 0">

                    <StackPanel>
                        <TextBlock Text="{Binding TotalLogs}"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Total"
                                   Foreground="#9CA3AF"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- CARD SUCESSO -->
                <Border Grid.Column="3"
                        Background="#102A1D"
                        CornerRadius="16"
                        Padding="18 12"
                        Margin="10 0 0 0">

                    <StackPanel>
                        <TextBlock Text="{Binding TotalSucesso}"
                                   Foreground="#4ADE80"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Sucessos"
                                   Foreground="#86EFAC"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- CARD FALHA -->
                <Border Grid.Column="4"
                        Background="#2A1111"
                        CornerRadius="16"
                        Padding="18 12"
                        Margin="10 0 0 0">

                    <StackPanel>
                        <TextBlock Text="{Binding TotalFalha}"
                                   Foreground="#F87171"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Falhas"
                                   Foreground="#FCA5A5"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- FILTROS -->
        <Border Grid.Row="1"
                Background="#171726"
                CornerRadius="20"
                Padding="18"
                Margin="20 0 20 12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.4*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- PESQUISA -->
                <Border Grid.Column="0"
                        Background="#0F0F1A"
                        CornerRadius="12"
                        Padding="12 0"
                        Height="44"
                        Margin="0 0 10 0"
                        BorderBrush="#2A2940"
                        BorderThickness="1">

                    <DockPanel VerticalAlignment="Center">

                        <iconPacks:PackIconMaterial Kind="Magnify"
                                                    Width="18"
                                                    Height="18"
                                                    Foreground="#9CA3AF"
                                                    Margin="0 0 8 0"
                                                    VerticalAlignment="Center"/>

                        <TextBox x:Name="txtPesquisa"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="White"
                                 FontSize="14"
                                 CaretBrush="White"
                                 VerticalContentAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- COMBO AÇÃO -->
                <ComboBox x:Name="cmbAcao"
                          Grid.Column="1"
                          Height="44"
                          Margin="0 0 10 0"
                          Background="#0F0F1A"
                          Foreground="White"
                          BorderBrush="#2A2940"
                          Padding="10 0"/>

                <!-- COMBO ENTIDADE -->
                <ComboBox x:Name="cmbEntidade"
                          Grid.Column="2"
                          Height="44"
                          Margin="0 0 10 0"
                          Background="#0F0F1A"
                          Foreground="White"
                          BorderBrush="#2A2940"
                          Padding="10 0"/>

                <!-- BOTÃO FILTRAR -->
                <Button Grid.Column="3"
                        Height="44"
                        Padding="22 0"
                        Margin="0 0 10 0"
                        Background="#7C3AED"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="BtnFiltrar_Click">

                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FilterVariant"
                                                    Width="17"
                                                    Height="17"
                                                    Foreground="White"
                                                    Margin="0 0 7 0"
                                                    VerticalAlignment="Center"/>

                        <TextBlock Text="Filtrar"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- BOTÃO LIMPAR -->
                <Button Grid.Column="4"
                        Height="44"
                        Padding="18 0"
                        Background="#27273A"
                        Foreground="#D1D5DB"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="BtnLimpar_Click">

                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Broom"
                                                    Width="17"
                                                    Height="17"
                                                    Foreground="#D1D5DB"
                                                    Margin="0 0 7 0"
                                                    VerticalAlignment="Center"/>

                        <TextBlock Text="Limpar"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- LISTA -->
        <ScrollViewer Grid.Row="2"
                      Margin="20 0 20 20"
                      VerticalScrollBarVisibility="Auto">

            <ItemsControl ItemsSource="{Binding Logs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border Background="#171726"
                                BorderBrush="#2A2940"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="14"
                                Margin="0 0 0 10">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="270"/>
                                    <ColumnDefinition Width="125"/>
                                </Grid.ColumnDefinitions>

                                <!-- ÍCONE DINÂMICO -->
                                <Border Grid.Column="0"
                                        Width="42"
                                        Height="42"
                                        CornerRadius="21"
                                        Background="{Binding CorFundo}"
                                        VerticalAlignment="Center">

                                    <iconPacks:PackIconMaterial Kind="{Binding Icone}"
                                                                Width="20"
                                                                Height="20"
                                                                Foreground="{Binding CorTexto}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                </Border>

                                <!-- INFORMAÇÕES DO LOG -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="{Binding TipoAcao}"
                                                   Foreground="{Binding CorTexto}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>

                                        <Border Background="#27273A"
                                                CornerRadius="8"
                                                Padding="8 3"
                                                Margin="10 0 0 0"
                                                VerticalAlignment="Center">

                                            <TextBlock Text="{Binding Sucesso, StringFormat=Status: {0}}"
                                                       Foreground="#D1D5DB"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Descricao}"
                                               Foreground="White"
                                               FontSize="12"
                                               Margin="0 5 0 0"
                                               TextWrapping="Wrap"/>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0 7 0 0">

                                        <Border Background="#2D1F4F"
                                                CornerRadius="7"
                                                Padding="8 3"
                                                Margin="0 0 8 0">

                                            <TextBlock Foreground="#A855F7"
                                                       FontSize="10"
                                                       FontWeight="SemiBold">
                                                <Run Text="{Binding EntidadeAfetada}"/>
                                                <Run Text=" #"/>
                                                <Run Text="{Binding EntidadeId}"/>
                                            </TextBlock>
                                        </Border>

                                        <Border Background="#1E293B"
                                                CornerRadius="7"
                                                Padding="8 3">

                                            <TextBlock Text="{Binding Erro}"
                                                       Foreground="#FCA5A5"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- USUÁRIO E COMPUTADOR -->
                                <Grid Grid.Column="2"
                                      VerticalAlignment="Center"
                                      Margin="14 0 0 0">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- USUÁRIO -->
                                    <StackPanel Grid.Row="0"
                                                Orientation="Horizontal"
                                                Margin="0 0 0 8">

                                        <iconPacks:PackIconMaterial Kind="AccountOutline"
                                                                    Width="15"
                                                                    Height="15"
                                                                    Foreground="#A855F7"
                                                                    Margin="0 0 7 0"
                                                                    VerticalAlignment="Center"/>

                                        <StackPanel>
                                            <TextBlock Text="{Binding UsuarioNome}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"/>

                                            <TextBlock Text="Usuário responsável"
                                                       Foreground="#9CA3AF"
                                                       FontSize="9"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- COMPUTADOR -->
                                    <StackPanel Grid.Row="1"
                                                Orientation="Horizontal">

                                        <iconPacks:PackIconMaterial Kind="DesktopClassic"
                                                                    Width="15"
                                                                    Height="15"
                                                                    Foreground="#A855F7"
                                                                    Margin="0 0 7 0"
                                                                    VerticalAlignment="Center"/>

                                        <TextBlock Text="{Binding NomeComputador}"
                                                   Foreground="#D1D5DB"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>

                                <!-- DATA -->
                                <StackPanel Grid.Column="3"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right">

                                        <iconPacks:PackIconMaterial Kind="CalendarMonthOutline"
                                                                    Width="13"
                                                                    Height="13"
                                                                    Foreground="#9CA3AF"
                                                                    Margin="0 0 5 0"
                                                                    VerticalAlignment="Center"/>

                                        <TextBlock Text="{Binding DataHora, StringFormat=dd/MM/yyyy}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0 5 0 0">

                                        <iconPacks:PackIconMaterial Kind="ClockOutline"
                                                                    Width="13"
                                                                    Height="13"
                                                                    Foreground="#9CA3AF"
                                                                    Margin="0 0 5 0"
                                                                    VerticalAlignment="Center"/>

                                        <TextBlock Text="{Binding DataHora, StringFormat=HH:mm:ss}"
                                                   Foreground="#9CA3AF"
                                                   FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>