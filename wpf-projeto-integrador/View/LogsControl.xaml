<UserControl x:Class="wpf_projeto_integrador.View.LogsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200">

    <Grid Background="#0F0F1A">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Background="#171726"
                CornerRadius="18"
                Padding="24"
                Margin="20 20 20 10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ICON -->
                <Border Width="70"
                        Height="70"
                        CornerRadius="35"
                        Background="#6D28D9">

                    <iconPacks:PackIconMaterial
                        Kind="ClipboardTextClock"
                        Width="34"
                        Height="34"
                        Foreground="White"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Border>

                <!-- TEXTOS -->
                <StackPanel Grid.Column="1"
                            Margin="18 0 0 0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Logs do Sistema"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"/>

                    <TextBlock Text="Monitore atividades e acessos administrativos"
                               Foreground="#9CA3AF"
                               FontSize="14"
                               Margin="0 6 0 0"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- FILTROS -->
        <Border Grid.Row="1"
                Background="#171726"
                CornerRadius="18"
                Padding="20"
                Margin="20 0 20 10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- PESQUISA -->
                <Border Background="#0F0F1A"
                        CornerRadius="10"
                        Padding="12 8"
                        Margin="0 0 10 0">

                    <DockPanel>

                        <iconPacks:PackIconMaterial
                            Kind="Magnify"
                            Width="18"
                            Height="18"
                            Foreground="#9CA3AF"
                            Margin="0 0 8 0"/>

                        <TextBox BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="White"
                                 FontSize="14"
                                 CaretBrush="White"
                                 Text="Pesquisar usuário, ação ou entidade..."/>
                    </DockPanel>
                </Border>

                <!-- COMBO ACAO -->
                <ComboBox Grid.Column="1"
                          Margin="0 0 10 0"
                          Background="#0F0F1A"
                          Foreground="White"
                          BorderBrush="#2A2940"
                          Height="42">

                    <ComboBoxItem Content="Todas ações"/>
                    <ComboBoxItem Content="Login"/>
                    <ComboBoxItem Content="Logout"/>
                    <ComboBoxItem Content="Criação"/>
                    <ComboBoxItem Content="Alteração"/>
                    <ComboBoxItem Content="Exclusão"/>
                </ComboBox>

                <!-- COMBO ENTIDADE -->
                <ComboBox Grid.Column="2"
                          Margin="0 0 10 0"
                          Background="#0F0F1A"
                          Foreground="White"
                          BorderBrush="#2A2940"
                          Height="42">

                    <ComboBoxItem Content="Todas entidades"/>
                    <ComboBoxItem Content="Administrador"/>
                    <ComboBoxItem Content="Empresa"/>
                    <ComboBoxItem Content="Instrumento"/>
                    <ComboBoxItem Content="Usuário"/>
                </ComboBox>

                <!-- BOTAO -->
                <Button Grid.Column="3"
                        Background="#7C3AED"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="24 10"
                        Cursor="Hand"
                        FontWeight="Bold"
                        Content="Filtrar"/>
            </Grid>
        </Border>

        <!-- LISTA -->
        <!-- LISTA -->
        <ScrollViewer Grid.Row="2"
              Margin="20 0 20 20"
              VerticalScrollBarVisibility="Auto">

            <ItemsControl ItemsSource="{Binding Logs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border Background="#171726"
                        BorderBrush="#2A2940"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0 0 0 8">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="105"/>
                                </Grid.ColumnDefinitions>

                                <!-- ICONE PRINCIPAL -->
                                <Border Width="38"
                                Height="38"
                                CornerRadius="19"
                                Background="#1F3B2C"
                                VerticalAlignment="Center">

                                    <iconPacks:PackIconMaterial
                                Kind="LoginVariant"
                                Width="18"
                                Height="18"
                                Foreground="#4ADE80"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                                </Border>

                                <!-- TEXTO -->
                                <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">

                                    <TextBlock Text="{Binding TipoAcao.Nome}"
                                       Foreground="#4ADE80"
                                       FontWeight="Bold"
                                       FontSize="14"/>

                                    <TextBlock Text="{Binding Descricao}"
                                       Foreground="White"
                                       FontSize="11"
                                       Margin="0 2 0 0"
                                       TextWrapping="Wrap"/>

                                    <Border Background="#2D1F4F"
                                    CornerRadius="6"
                                    Padding="7 2"
                                    HorizontalAlignment="Left"
                                    Margin="0 5 0 0">

                                        <TextBlock Foreground="#A855F7"
                                           FontSize="9"
                                           FontWeight="SemiBold">
                                    <Run Text="{Binding Entidade}"/>
                                    <Run Text=" #"/>
                                    <Run Text="{Binding EntidadeId}"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>

                                <!-- USUARIO + PC -->
                                <Grid Grid.Column="2"
                              VerticalAlignment="Center"
                              Margin="10 0 0 0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- USUARIO -->
                                    <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                        <iconPacks:PackIconMaterial
                                    Kind="AccountOutline"
                                    Width="12"
                                    Height="12"
                                    Foreground="#A855F7"
                                    VerticalAlignment="Center"
                                    Margin="0 0 5 0"/>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Usuario.NomeUsuario}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="10"/>

                                            <TextBlock Text="Administrador"
                                               Foreground="#9CA3AF"
                                               FontSize="8"
                                               Margin="0 1 0 0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- PC -->
                                    <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                        <iconPacks:PackIconMaterial
                                    Kind="DesktopClassic"
                                    Width="13"
                                    Height="13"
                                    Foreground="#A855F7"
                                    VerticalAlignment="Center"
                                    Margin="0 0 5 0"/>

                                        <TextBlock Text="{Binding NomeComputador}"
                                           Foreground="White"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>

                                <!-- DATA -->
                                <StackPanel Grid.Column="3"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">

                                    <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">

                                        <iconPacks:PackIconMaterial
                                    Kind="ClockOutline"
                                    Width="11"
                                    Height="11"
                                    Foreground="#9CA3AF"
                                    VerticalAlignment="Center"
                                    Margin="0 0 4 0"/>

                                        <TextBlock Text="{Binding DataHora, StringFormat=dd/MM/yyyy}"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="10"
                                           VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding DataHora, StringFormat=HH:mm:ss}"
                                       Foreground="#9CA3AF"
                                       FontSize="9"
                                       Margin="0 2 0 0"
                                       HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>



    </Grid>
</UserControl>
