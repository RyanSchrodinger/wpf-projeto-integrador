<UserControl x:Class="wpf_projeto_integrador.View.Locacoes.GestaoLocacaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="28">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,24">

                <TextBlock Text="Gestão de Locações"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#25283D"/>

                <TextBlock Text="Acompanhe as locações realizadas na plataforma."
                           Margin="0,6,0,0"
                           FontSize="14"
                           Foreground="#75788A"/>

            </StackPanel>

            <!-- Cards -->
            <UniformGrid Grid.Row="1"
                         Columns="4"
                         Margin="0,0,0,24">

                <!-- Total -->
                <Border Margin="0,0,10,0"
                        Padding="20"
                        Background="White"
                        CornerRadius="12">

                    <StackPanel>
                        <TextBlock Text="Total de locações"
                                   FontSize="14"
                                   Foreground="#777A8B"/>

                        <TextBlock Text="{Binding TotalLocacoes}"
                                   Margin="0,12,0,0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#25283D"/>
                    </StackPanel>

                </Border>

                <!-- Ativas -->
                <Border Margin="10,0"
                        Padding="20"
                        Background="White"
                        CornerRadius="12">

                    <StackPanel>
                        <TextBlock Text="Locações ativas"
                                   FontSize="14"
                                   Foreground="#777A8B"/>

                        <TextBlock Text="{Binding LocacoesAtivas}"
                                   Margin="0,12,0,0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#25283D"/>
                    </StackPanel>

                </Border>

                <!-- Pendentes -->
                <Border Margin="10,0"
                        Padding="20"
                        Background="White"
                        CornerRadius="12">

                    <StackPanel>
                        <TextBlock Text="Pendentes"
                                   FontSize="14"
                                   Foreground="#777A8B"/>

                        <TextBlock Text="{Binding LocacoesPendentes}"
                                   Margin="0,12,0,0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#25283D"/>
                    </StackPanel>

                </Border>

                <!-- Finalizadas -->
                <Border Margin="10,0,0,0"
                        Padding="20"
                        Background="White"
                        CornerRadius="12">

                    <StackPanel>
                        <TextBlock Text="Finalizadas"
                                   FontSize="14"
                                   Foreground="#777A8B"/>

                        <TextBlock Text="{Binding LocacoesFinalizadas}"
                                   Margin="0,12,0,0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#25283D"/>
                    </StackPanel>

                </Border>

            </UniformGrid>

            <!-- Gráfico temporário -->
            <Border Grid.Row="2"
                    Margin="0,0,0,24"
                    Padding="22"
                    Background="White"
                    CornerRadius="12">

                <StackPanel>

                    <TextBlock Text="Locações por status"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#25283D"/>

                    <TextBlock Text="Distribuição atual das locações"
                               Margin="0,5,0,22"
                               FontSize="13"
                               Foreground="#818496"/>

                    <!-- Ativas -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Ativas"
                                   VerticalAlignment="Center"
                                   Foreground="#55586A"/>

                        <Grid Grid.Column="1"
                              Height="14"
                              Margin="10,0"
                              Background="#ECEEF4">

                            <Border Width="260"
                                    HorizontalAlignment="Left"
                                    Background="#696CFF"
                                    CornerRadius="7"/>
                        </Grid>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding LocacoesAtivas}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#25283D"/>
                    </Grid>

                    <!-- Pendentes -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Pendentes"
                                   VerticalAlignment="Center"
                                   Foreground="#55586A"/>

                        <Grid Grid.Column="1"
                              Height="14"
                              Margin="10,0"
                              Background="#ECEEF4">

                            <Border Width="180"
                                    HorizontalAlignment="Left"
                                    Background="#FFB648"
                                    CornerRadius="7"/>
                        </Grid>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding LocacoesPendentes}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#25283D"/>
                    </Grid>

                    <!-- Finalizadas -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Finalizadas"
                                   VerticalAlignment="Center"
                                   Foreground="#55586A"/>

                        <Grid Grid.Column="1"
                              Height="14"
                              Margin="10,0"
                              Background="#ECEEF4">

                            <Border Width="420"
                                    HorizontalAlignment="Left"
                                    Background="#44C789"
                                    CornerRadius="7"/>
                        </Grid>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding LocacoesFinalizadas}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#25283D"/>
                    </Grid>

                </StackPanel>

            </Border>

            <!-- Tabela -->
            <Border Grid.Row="3"
                    Padding="22"
                    Background="White"
                    CornerRadius="12">

                <StackPanel>

                    <TextBlock Text="Últimas locações"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#25283D"/>

                    <TextBlock Text="Locações registradas recentemente"
                               Margin="0,5,0,18"
                               FontSize="13"
                               Foreground="#818496"/>

                    <DataGrid ItemsSource="{Binding UltimasLocacoes}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="Transparent"
                              RowHeight="45"
                              ColumnHeaderHeight="42">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Cliente"
                                                Binding="{Binding Cliente}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Prestador"
                                                Binding="{Binding Prestador}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Serviço"
                                                Binding="{Binding Servico}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Data"
                                                Binding="{Binding Data}"
                                                Width="130"/>

                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="130"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>