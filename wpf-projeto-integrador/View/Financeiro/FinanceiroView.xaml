<UserControl x:Class="wpf_projeto_integrador.View.Financeiro.FinanceiroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#0B1024">

    
   <Grid Background="#0B1024">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">

            <Grid Margin="22">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="280"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- CABEÇALHO -->
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Financeiro"
                                   FontSize="31"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Acompanhe receitas e movimentações financeiras da plataforma."
                                   FontSize="14"
                                   Foreground="#94A3B8"
                                   Margin="0 3 0 0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Width="120"
                                Height="42"
                                Margin="0 0 10 0"
                                Style="{StaticResource BotaoSecundario}"
                                Click="BtnAtualizar_Click">

                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="Refresh"
                                                       Width="16"
                                                       Height="16"
                                                       Margin="0 0 8 0"/>

                                <TextBlock Text="Atualizar"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Width="120"
                                Height="42"
                                Style="{StaticResource BotaoRoxoTelas}"
                                Click="BtnExportarExcel_Click">

                            <StackPanel Orientation="Horizontal">
                                 <Icon:PackIconMaterial Kind="Download"
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0 0 8 0"/>

                                 <TextBlock Text="Exportar"
                                            VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Grid>

                <!-- CARDS -->
                <UniformGrid Grid.Row="1"
                             Columns="4"
                             Margin="0 20 0 14">

                    <!-- RECEITA TOTAL -->
                    <Border Style="{StaticResource CardResumo}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                             <Border Width="42"
                                     Height="42"
                                     CornerRadius="21"
                                     Background="#2D1B69"
                                     VerticalAlignment="Center">

                                <Icon:PackIconMaterial Kind="CurrencyUsd"
                                            Foreground="#A78BFA"
                                            Width="22"
                                            Height="22"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                            </Border>

                             <StackPanel Grid.Column="1"
                                         VerticalAlignment="Center">
 
                                 <TextBlock Text="Receita Total"
                                            Style="{StaticResource TextoCard}"/>

                                 <TextBlock x:Name="txtReceitaTotal"
                                             Text="R$ 0,00"
                                            Style="{StaticResource NumeroCard}"/>

                                 <TextBlock Text="Tudo que entrou na plataforma"
                                            Foreground="#A78BFA"
                                            FontSize="11"/> 
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- RECEITA DO MÊS -->
                    <Border Style="{StaticResource CardResumo}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                             <Border Width="42"
                                     Height="42"
                                     CornerRadius="21"
                                     Background="#123829"
                                     VerticalAlignment="Center">

                                <Icon:PackIconMaterial Kind="CalendarMonth"
                                            Foreground="#22C55E"
                                            Width="22"
                                            Height="22"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                            </Border>

                             <StackPanel Grid.Column="1"
                                         VerticalAlignment="Center">

                                 <TextBlock Text="Receita do Mês"
                                            Style="{StaticResource TextoCard}"/>

                                 <TextBlock x:Name="txtReceitaMes"
                                            Text="R$ 0,00"
                                            Style="{StaticResource NumeroCard}"/>

                                 <TextBlock Text="Entradas no mês atual"
                                            Foreground="#22C55E"
                                            FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- RECEITA DE HOJE -->
                    <Border Style="{StaticResource CardResumo}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="42"
                         Height="42"
                         CornerRadius="21"
                         Background="#11315B"
                         VerticalAlignment="Center">

                                <Icon:PackIconMaterial Kind="ClockOutline"
                                            Foreground="#38BDF8"
                                            Width="22"
                                            Height="22"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                             VerticalAlignment="Center">

                                <TextBlock Text="Receita de Hoje"
                                Style="{StaticResource TextoCard}"/>

                                <TextBlock x:Name="txtReceitaHoje"
                                Text="R$ 0,00"
                                Style="{StaticResource NumeroCard}"/>

                                <TextBlock Text="Entradas registradas hoje"
                                Foreground="#38BDF8"
                                FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- TICKET MÉDIO -->
                    <Border Style="{StaticResource CardResumo}"
                 Margin="0">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="42"
                         Height="42"
                         CornerRadius="21"
                         Background="#3A3012"
                         VerticalAlignment="Center">

                                <Icon:PackIconMaterial Kind="TicketPercentOutline"
                                            Foreground="#FACC15"
                                            Width="22"
                                            Height="22"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                             VerticalAlignment="Center">

                                <TextBlock Text="Ticket Médio"
                                Style="{StaticResource TextoCard}"/>

                                <TextBlock x:Name="txtTicketMedio"
                                Text="R$ 0,00"
                                Style="{StaticResource NumeroCard}"/>

                                <TextBlock Text="Média por pagamento"
                                Foreground="#FACC15"
                                FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </UniformGrid>

                <!-- FILTROS -->
                <Grid Grid.Row="2"
           Margin="0 0 0 14">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- BUSCA -->
                    <Border Grid.Column="0"
                 Style="{StaticResource InputBox}"
                 Height="54"
                 Margin="0 0 12 0">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Icon:PackIconMaterial Kind="Magnify"
                                        Width="18"
                                        Height="18"
                                        Foreground="#94A3B8"
                                        VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                          x:Name="txtBusca"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="White"
                          CaretBrush="White"
                          FontSize="13"
                          VerticalContentAlignment="Center"
                          TextChanged="txtBusca_TextChanged">

                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="ToolTip"
                                     Value="Buscar por cliente, origem, categoria, forma ou status"/>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>

                    <!-- CATEGORIA -->
                    <Border Grid.Column="1"
                 Background="#11162D"
                 BorderBrush="#252B46"
                 BorderThickness="1"
                 CornerRadius="10"
                 Height="54"
                 Padding="12 5"
                 Margin="0 0 12 0">

                        <StackPanel>
                            <TextBlock Text="Categoria"
                            Foreground="#94A3B8"
                            FontSize="10"/>

                            <ComboBox x:Name="cmbCategoria"
                           Style="{StaticResource ComboBoxModerno}"
                           SelectionChanged="Filtro_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- STATUS -->
                    <Border Grid.Column="2"
                 Background="#11162D"
                 BorderBrush="#252B46"
                 BorderThickness="1"
                 CornerRadius="10"
                 Height="54"
                 Padding="12 5"
                 Margin="0 0 12 0">

                        <StackPanel>
                            <TextBlock Text="Status"
                            Foreground="#94A3B8"
                            FontSize="10"/>

                            <ComboBox x:Name="cmbStatus"
                           Style="{StaticResource ComboBoxModerno}"
                           SelectionChanged="Filtro_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- PERÍODO -->
                    <Border Grid.Column="3"
                 Background="#11162D"
                 BorderBrush="#252B46"
                 BorderThickness="1"
                 CornerRadius="10"
                 Height="54"
                 Padding="12 5">

                        <StackPanel>
                            <TextBlock Text="Período"
                            Foreground="#94A3B8"
                            FontSize="10"/>

                            <ComboBox x:Name="cmbPeriodo"
                           Style="{StaticResource ComboBoxModerno}"
                           SelectionChanged="Filtro_Changed">

                                <ComboBoxItem Content="Todos"
                                   IsSelected="True"/>

                                <ComboBoxItem Content="Hoje"/>

                                <ComboBoxItem Content="Este mês"/>

                                <ComboBoxItem Content="Este ano"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                </Grid>

                <!-- GRÁFICO -->
                <Border Grid.Row="3"
             Background="#11162B"
             BorderBrush="#1F2942"
             BorderThickness="1"
             CornerRadius="16"
             Padding="16"
             Margin="0 0 0 14">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Receita Mensal"
                                Foreground="White"
                                FontSize="18"
                                FontWeight="Bold"/>

                                <TextBlock Text="Receitas pagas ao longo do ano"
                                Foreground="#64748B"
                                FontSize="11"
                                Margin="0 2 0 0"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                         Background="#1A2038"
                         BorderBrush="#2C3555"
                         BorderThickness="1"
                         CornerRadius="8"
                         Padding="10 5"
                         VerticalAlignment="Top">

                                <TextBlock Text="Ano atual"
                                Foreground="#CBD5E1"
                                FontSize="11"/>
                            </Border>
                        </Grid>

                        <lvc:CartesianChart Grid.Row="1"
                                 x:Name="graficoReceitaMensal"
                                 Background="Transparent"
                                 Margin="0 8 0 0"/>
                    </Grid>
                </Border>

                <!-- TABELA -->
                <Border Grid.Row="4"
                        Background="#11162B"
                        BorderBrush="#1F2942"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14"
                        Margin="0 0 0 22"
                        MinHeight="300">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>

                        <!-- TÍTULO -->
                       <Grid Grid.Row="0"
                             Margin="2 0 2 10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                 <TextBlock Text="Últimas movimentações"
                                            Foreground="White"
                                            FontSize="18"
                                            FontWeight="Bold"/>

                                 <TextBlock Text="Pagamentos encontrados com os filtros selecionados"
                                            Foreground="#64748B"
                                            FontSize="11"
                                            Margin="0 2 0 0"/>
                            </StackPanel>

                             <TextBlock Grid.Column="1"
                                        x:Name="txtQuantidadeRegistros"
                                        Text="0 registros"
                                        Foreground="#94A3B8"
                                        FontSize="12"
                                        VerticalAlignment="Center"/>
                        </Grid>

                        <!-- DATAGRID -->
                         <DataGrid Grid.Row="1"
                                   x:Name="dgPagamentos"
                                   AutoGenerateColumns="False"
                                   CanUserAddRows="False"
                                   IsReadOnly="True"
                                   HeadersVisibility="Column"
                                   GridLinesVisibility="None"
                                   Background="Transparent"
                                   BorderThickness="0"
                                   Foreground="White"
                                   RowHeight="58"
                                   ColumnHeaderHeight="38"
                                   RowBackground="Transparent"
                                   AlternatingRowBackground="Transparent"
                                   VerticalScrollBarVisibility="Disabled"
                                   HorizontalScrollBarVisibility="Disabled"
                                   PreviewMouseWheel="dgPagamentos_PreviewMouseWheel">

                            <DataGrid.Resources>

                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background"
                                 Value="#141A31"/>

                                    <Setter Property="Foreground"
                                 Value="#CBD5E1"/>

                                    <Setter Property="FontWeight"
                                 Value="SemiBold"/>

                                    <Setter Property="FontSize"
                                 Value="12"/>

                                    <Setter Property="BorderBrush"
                                 Value="#232C48"/>

                                    <Setter Property="BorderThickness"
                                 Value="0 0 0 1"/>

                                    <Setter Property="Padding"
                                 Value="10 0"/>
                                </Style>

                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background"
                                 Value="Transparent"/>

                                    <Setter Property="BorderThickness"
                                 Value="0"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridRow">

                                                 <Border x:Name="Linha"
                                                         Background="#151B34"
                                                         BorderBrush="#232C48"
                                                         BorderThickness="0 0 0 1">

                                                    <DataGridCellsPresenter/>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                  Value="True">

                                                        <Setter TargetName="Linha"
                                                     Property="Background"
                                                     Value="#1A213D"/>
                                                    </Trigger>

                                                    <Trigger Property="IsSelected"
                                                  Value="True">

                                                        <Setter TargetName="Linha"
                                                     Property="Background"
                                                     Value="#20294A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background"
                                 Value="Transparent"/>

                                    <Setter Property="Foreground"
                                 Value="White"/>

                                    <Setter Property="BorderThickness"
                                 Value="0"/>

                                    <Setter Property="Padding"
                                 Value="10 0"/>

                                    <Setter Property="VerticalAlignment"
                                 Value="Center"/>

                                    <Setter Property="FocusVisualStyle"
                                 Value="{x:Null}"/>
                                </Style>

                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <!-- CLIENTE -->
                                <DataGridTemplateColumn Header="Cliente"
                                             Width="2*">

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>

                                            <StackPanel VerticalAlignment="Center">

                                                <TextBlock Text="{Binding Cliente}"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                FontSize="12"/>

                                                <TextBlock Text="{Binding Origem}"
                                                Foreground="#64748B"
                                                FontSize="10"
                                                Margin="0 2 0 0"/>
                                            </StackPanel>

                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- CATEGORIA -->
                                <DataGridTemplateColumn Header="Categoria"
                                             Width="1.2*">

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>

                                            <Border Background="#2B1B57"
                                         CornerRadius="8"
                                         Padding="8 3"
                                         HorizontalAlignment="Left">

                                                <TextBlock Text="{Binding Categoria}"
                                                Foreground="#C084FC"
                                                FontWeight="SemiBold"
                                                FontSize="10"/>
                                            </Border>

                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- FORMA -->
                                <DataGridTextColumn Header="Forma"
                                         Binding="{Binding FormaPagamento}"
                                         Width="1.3*"/>

                                <!-- VALOR -->
                                <DataGridTextColumn Header="Valor"
                                         Binding="{Binding ValorFormatado}"
                                         Width="1.1*"/>

                                <!-- STATUS -->
                                <DataGridTemplateColumn Header="Status"
                                             Width="1*">

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>

                                            <Border CornerRadius="8"
                                         Padding="8 3"
                                         HorizontalAlignment="Left">

                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background"
                                                     Value="#10382B"/>

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding Status}"
                                                              Value="Pendente">
                                                                <Setter Property="Background"
                                                             Value="#3A3012"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding Status}"
                                                              Value="Vencido">
                                                                <Setter Property="Background"
                                                             Value="#451927"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding Status}"
                                                              Value="Cancelado">
                                                                <Setter Property="Background"
                                                             Value="#27272A"/>
                                                            </DataTrigger>

                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel Orientation="Horizontal">

                                                    <Ellipse Width="6"
                                                  Height="6"
                                                  Margin="0 0 6 0"
                                                  VerticalAlignment="Center">

                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill"
                                                             Value="#22C55E"/>

                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding Status}"
                                                                      Value="Pendente">
                                                                        <Setter Property="Fill"
                                                                     Value="#FACC15"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding Status}"
                                                                      Value="Vencido">
                                                                        <Setter Property="Fill"
                                                                     Value="#EF4444"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding Status}"
                                                                      Value="Cancelado">
                                                                        <Setter Property="Fill"
                                                                     Value="#A1A1AA"/>
                                                                    </DataTrigger>

                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>

                                                    <TextBlock Text="{Binding Status}"
                                                    FontWeight="SemiBold"
                                                    FontSize="10">

                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                             Value="#22C55E"/>

                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding Status}"
                                                                      Value="Pendente">
                                                                        <Setter Property="Foreground"
                                                                     Value="#FACC15"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding Status}"
                                                                      Value="Vencido">
                                                                        <Setter Property="Foreground"
                                                                     Value="#EF4444"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding Status}"
                                                                      Value="Cancelado">
                                                                        <Setter Property="Foreground"
                                                                     Value="#A1A1AA"/>
                                                                    </DataTrigger>

                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- DATA -->
                                <DataGridTextColumn Header="Data"
                                         Binding="{Binding Data}"
                                         Width="1*"/>

                                <!-- AÇÕES -->
                                <DataGridTemplateColumn Header="Ações"
                                             Width="70">

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>

                                            <Button Width="34"
                                         Height="30"
                                         Background="#171E36"
                                         BorderBrush="#334155"
                                         BorderThickness="1"
                                         Cursor="Hand"
                                         Click="BtnVisualizar_Click">

                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">

                                                        <Border x:Name="Fundo"
                                                     Background="{TemplateBinding Background}"
                                                     BorderBrush="{TemplateBinding BorderBrush}"
                                                     BorderThickness="{TemplateBinding BorderThickness}"
                                                     CornerRadius="7">

                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        </Border>

                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver"
                                                          Value="True">

                                                                <Setter TargetName="Fundo"
                                                             Property="Background"
                                                             Value="#2A3558"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>

                                                    </ControlTemplate>
                                                </Button.Template>

                                                <Icon:PackIconMaterial Kind="EyeOutline"
                                                            Width="15"
                                                            Height="15"
                                                            Foreground="White"/>
                                            </Button>

                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- PAGINAÇÃO -->
                        <Grid Grid.Row="2"
                   Margin="4 8 4 0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="txtResumoPagina"
                            Text="Mostrando 0 de 0 registros"
                            Foreground="#64748B"
                            FontSize="11"
                            VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1"
                             Orientation="Horizontal">

                                <Button x:Name="btnPaginaAnterior"
                             Width="36"
                             Height="32"
                             Margin="0 0 6 0"
                             Background="#171E36"
                             Foreground="White"
                             BorderBrush="#334155"
                             BorderThickness="1"
                             Cursor="Hand"
                             Click="BtnPaginaAnterior_Click">

                                    <Icon:PackIconMaterial Kind="ChevronLeft"
                                                Width="16"
                                                Height="16"/>
                                </Button>

                                <Border MinWidth="90"
                             Height="32"
                             Background="#2D1B69"
                             CornerRadius="7"
                             Padding="10 0"
                             Margin="0 0 6 0">

                                    <TextBlock x:Name="txtPaginaAtual"
                                    Text="Página 1 de 1"
                                    Foreground="#C4B5FD"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                                </Border>

                                <Button x:Name="btnProximaPagina"
                             Width="36"
                             Height="32"
                             Background="#171E36"
                             Foreground="White"
                             BorderBrush="#334155"
                             BorderThickness="1"
                             Cursor="Hand"
                             Click="BtnProximaPagina_Click">

                                    <Icon:PackIconMaterial Kind="ChevronRight"
                                                Width="16"
                                                Height="16"/>
                                </Button>

                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>







        </ScrollViewer>

    </Grid> 
</UserControl>