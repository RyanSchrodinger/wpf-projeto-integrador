<UserControl x:Class="wpf_projeto_integrador.View.Financeiro.FinanceiroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#0B1024">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <StackPanel>
            <TextBlock Text="Financeiro"
                       FontSize="31"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock Text="Acompanhe receitas, categorias e últimas movimentações da plataforma."
                       FontSize="14"
                       Foreground="#CBD5E1"/>
        </StackPanel>

        <!-- CARDS -->
        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="0 18 0 10">

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextoCard}">Receita Total</TextBlock>
                    <TextBlock Style="{StaticResource NumeroCard}" x:Name="txtReceitaTotal">R$ 0,00</TextBlock>
                    <TextBlock Text="Tudo que entrou na plataforma" Foreground="#8B5CF6" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextoCard}">Receita do Mês</TextBlock>
                    <TextBlock Style="{StaticResource NumeroCard}" x:Name="txtReceitaMes">R$ 0,00</TextBlock>
                    <TextBlock Text="Entradas no mês atual" Foreground="#22C55E" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextoCard}">Receita de Hoje</TextBlock>
                    <TextBlock Style="{StaticResource NumeroCard}" x:Name="txtReceitaHoje">R$ 0,00</TextBlock>
                    <TextBlock Text="Entradas registradas hoje" Foreground="#38BDF8" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextoCard}">Ticket Médio</TextBlock>
                    <TextBlock Style="{StaticResource NumeroCard}" x:Name="txtTicketMedio">R$ 0,00</TextBlock>
                    <TextBlock Text="Média por pagamento" Foreground="#FACC15" FontSize="11"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- FILTROS -->
        <Grid Grid.Row="2" Margin="0 0 10 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <Border Background="#11162D"
                    BorderBrush="#252B46"
                    BorderThickness="1"
                    CornerRadius="10"
                    Height="58"
                    Padding="14 0">

                <TextBox x:Name="txtBusca"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         TextChanged="txtBusca_TextChanged"/>
            </Border>

            <Border Grid.Column="1"
                    Margin="14 0 0 0"
                    Background="#11162D"
                    BorderBrush="#252B46"
                    BorderThickness="1"
                    CornerRadius="10"
                    Height="58"
                    Padding="12 6">

                <StackPanel>
                    <TextBlock Text="Categoria"
                               Foreground="#94A3B8"
                               FontSize="11"/>

                    <ComboBox x:Name="cmbCategoria"
                              Style="{StaticResource ComboBoxModerno}"
                              Foreground="White"
                              FontSize="14"
                              SelectionChanged="Filtro_Changed"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Margin="14 0 0 0"
                    Background="#11162D"
                    BorderBrush="#252B46"
                    BorderThickness="1"
                    CornerRadius="10"
                    Height="58"
                    Padding="12 6">

                <StackPanel>
                    <TextBlock Text="Status"
                               Foreground="#94A3B8"
                               FontSize="11"/>

                    <ComboBox x:Name="cmbStatus"
                              Style="{StaticResource ComboBoxModerno}"
                              Foreground="White"
                              FontSize="14"
                              SelectionChanged="Filtro_Changed"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Margin="14 0 0 0"
                    Background="#11162D"
                    BorderBrush="#252B46"
                    BorderThickness="1"
                    CornerRadius="10"
                    Height="58"
                    Padding="12 6">

                <StackPanel>
                    <TextBlock Text="Período"
                               Foreground="#94A3B8"
                               FontSize="11"/>

                    <ComboBox x:Name="cmbPeriodo"
                              Style="{StaticResource ComboBoxModerno}"
                              Foreground="White"
                              FontSize="14"
                              SelectionChanged="Filtro_Changed">
                        <ComboBoxItem Content="Todos" IsSelected="True"/>
                        <ComboBoxItem Content="Hoje"/>
                        <ComboBoxItem Content="Este mês"/>
                        <ComboBoxItem Content="Este ano"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="4"
                        Orientation="Horizontal"
                        Margin="10 0 0 0">

                <Button Width="110"
                        Style="{StaticResource BotaoRoxoTelas}"
                        Content="Atualizar"
                        Margin="0 10 8 10"
                        Click="BtnAtualizar_Click"/>

                <Button Width="120"
                        Style="{StaticResource BotaoRoxoTelas}"
                        Content="Exportar"
                        Margin="0 10 0 10"
                        Click="BtnExportarExcel_Click"/>
            </StackPanel>
        </Grid>

        <!-- CONTEÚDO COM SCROLL -->
        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0 0 15 0">

            <Grid MinHeight="1150">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- LADO ESQUERDO -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="360"/>
                        <RowDefinition Height="720"/>
                    </Grid.RowDefinitions>

                    <!-- GRÁFICO MENSAL -->
                    <Border Background="#11162B"
                            BorderBrush="#1F2942"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="16"
                            Margin="0 0 0 12">

                        <StackPanel>
                            <TextBlock Text="Receita Mensal"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0 0 0 8"/>

                            <lvc:CartesianChart x:Name="graficoReceitaMensal"
                                                Height="285"
                                                Background="Transparent"/>
                        </StackPanel>
                    </Border>

                    <!-- TABELA -->
                    <Border Grid.Row="1"
                            Background="#11162B"
                            BorderBrush="#1F2942"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="14 12">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Últimas Movimentações"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0 0 0 10"/>

                            <DataGrid Grid.Row="1"
                                      x:Name="dgPagamentos"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Foreground="White"
                                      RowHeight="72"
                                      ColumnHeaderHeight="42"
                                      RowBackground="Transparent"
                                      AlternatingRowBackground="Transparent">

                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#CBD5E1"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="10 0"/>
                                    </Style>

                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Margin" Value="0 0 0 4"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridRow">
                                                    <Grid>
                                                        <Border Background="#151B34"
                                                                BorderBrush="#252B46"
                                                                BorderThickness="1"
                                                                CornerRadius="8">
                                                            <Grid>
                                                                <Border Width="3"
                                                                        Background="{Binding CorCategoria}"
                                                                        HorizontalAlignment="Left"
                                                                        CornerRadius="8 0 0 8"/>

                                                                <SelectiveScrollingGrid Margin="6 0 0 0">
                                                                    <SelectiveScrollingGrid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </SelectiveScrollingGrid.ColumnDefinitions>

                                                                    <DataGridCellsPresenter Grid.Column="1"/>
                                                                </SelectiveScrollingGrid>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>

                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="10 0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    </Style>
                                </DataGrid.Resources>

                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Cliente" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Cliente}"
                                                               Foreground="White"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"/>

                                                    <TextBlock Text="{Binding Origem}"
                                                               Foreground="#94A3B8"
                                                               FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Categoria" Width="1.3*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#2B1B57"
                                                        CornerRadius="8"
                                                        Padding="8 2"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Categoria}"
                                                               Foreground="#A855F7"
                                                               FontWeight="SemiBold"
                                                               FontSize="10"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Forma"
                                                        Binding="{Binding FormaPagamento}"
                                                        Width="1.2*"/>

                                    <DataGridTextColumn Header="Valor"
                                                        Binding="{Binding ValorFormatado}"
                                                        Width="1.1*"/>

                                    <DataGridTemplateColumn Header="Status" Width="1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8"
                                                        Padding="8 2"
                                                        HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#0F3B2E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Pendente">
                                                                    <Setter Property="Background" Value="#3A2F11"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Vencido">
                                                                    <Setter Property="Background" Value="#4A1D2A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Cancelado">
                                                                    <Setter Property="Background" Value="#27272A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <TextBlock Text="{Binding Status}"
                                                               FontWeight="SemiBold"
                                                               FontSize="10">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#22C55E"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Pendente">
                                                                        <Setter Property="Foreground" Value="#FACC15"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Vencido">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Cancelado">
                                                                        <Setter Property="Foreground" Value="#A1A1AA"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Data"
                                                        Binding="{Binding Data}"
                                                        Width="1*"/>

                                    <DataGridTemplateColumn Header="Ações" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Width="34"
                                                        Height="30"
                                                        Background="#151A32"
                                                        BorderBrush="#334155"
                                                        BorderThickness="1"
                                                        Click="BtnVisualizar_Click">

                                                    <Icon:PackIconMaterial Kind="EyeOutline"
                                                                           Width="15"
                                                                           Height="15"
                                                                           Foreground="White"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- PAINEL LATERAL -->
                <StackPanel Grid.Column="1" Margin="14 0 0 0">

                    <Border Background="#11162B"
                            BorderBrush="#1F2942"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="16"
                            Margin="0 0 0 12">

                        <StackPanel>
                            <TextBlock Text="Receita por Categoria"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0 0 0 8"/>

                            <lvc:PieChart x:Name="graficoCategorias"
                                          Height="210"
                                          LegendPosition="Right"
                                          Background="Transparent"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#11162B"
                            BorderBrush="#1F2942"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="16"
                            Margin="0 0 0 12">

                        <StackPanel>
                            <TextBlock Text="Indicadores"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0 0 0 12"/>

                            <TextBlock Text="Pagamentos Pagos"
                                       Foreground="#94A3B8"
                                       FontSize="12"/>
                            <TextBlock x:Name="txtPagos"
                                       Text="0"
                                       Foreground="#22C55E"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Margin="0 0 0 8"/>

                            <TextBlock Text="Pendentes"
                                       Foreground="#94A3B8"
                                       FontSize="12"/>
                            <TextBlock x:Name="txtPendentes"
                                       Text="0"
                                       Foreground="#FACC15"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Margin="0 0 0 8"/>

                            <TextBlock Text="Vencidos"
                                       Foreground="#94A3B8"
                                       FontSize="12"/>
                            <TextBlock x:Name="txtVencidos"
                                       Text="0"
                                       Foreground="#EF4444"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#11162B"
                            BorderBrush="#1F2942"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="16"
                            Margin="0 0 0 20">

                        <StackPanel>
                            <TextBlock Text="Resumo Rápido"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0 0 0 12"/>

                            <TextBlock Text="Categoria destaque"
                                       Foreground="#94A3B8"
                                       FontSize="12"/>
                            <TextBlock x:Name="txtCategoriaDestaque"
                                       Text="Nenhuma"
                                       Foreground="#A855F7"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Margin="0 0 0 10"/>

                            <TextBlock Text="Melhor mês"
                                       Foreground="#94A3B8"
                                       FontSize="12"/>
                            <TextBlock x:Name="txtMelhorMes"
                                       Text="Nenhum"
                                       Foreground="#38BDF8"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>