<UserControl x:Class="wpf_projeto_integrador.View.Financeiro.DashboardFinanceiroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B1024">

    <Grid Margin="22">

        <StackPanel>

            <TextBlock Text="Dashboard Financeiro"
                       Foreground="White"
                       FontSize="31"
                       FontWeight="Bold"/>

            <TextBlock Text="Análises, gráficos e indicadores financeiros da plataforma."
                       Foreground="#CBD5E1"
                       FontSize="14"
                       Margin="0 4 0 0"/>

            <Border Background="#11162B"
                    BorderBrush="#1F2942"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="24"
                    Margin="0 24 0 0">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="📊"
                               FontSize="50"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Dashboard Analítico"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0 12 0 0"/>

                    <TextBlock Text="Os gráficos serão adicionados nesta tela."
                               Foreground="#94A3B8"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0 6 0 0"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </Grid>

</UserControl>