<UserControl x:Class="wpf_projeto_integrador.View.GestaoServicos.GestaoServicosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#0B1024">

    <Grid Background="#0B1024">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">

            <Grid Margin="22">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="280"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ================================================= -->
                <!-- CABEÇALHO -->
                <!-- ================================================= -->

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="Gestão de Serviços"
                                   FontSize="31"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Acompanhe os serviços, pedidos, profissionais e avaliações da plataforma."
                                   FontSize="14"
                                   Foreground="#94A3B8"
                                   Margin="0 3 0 0"/>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="120"
                            Height="42"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotaoSecundario}"
                            Click="BtnAtualizar_Click">

                        <StackPanel Orientation="Horizontal">

                            <Icon:PackIconMaterial Kind="Refresh"
                                                   Width="16"
                                                   Height="16"
                                                   Margin="0 0 8 0"/>

                            <TextBlock Text="Atualizar"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </Grid>

                <!-- ================================================= -->
                <!-- CARDS -->
                <!-- ================================================= -->

                <UniformGrid Grid.Row="1"
                             Columns="4"
                             Margin="0 20 0 14">

                    <!-- SERVIÇOS ATIVOS -->

                    <Border Style="{StaticResource CardResumo}">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="42"
                                    Height="42"
                                    CornerRadius="21"
                                    Background="#2D1B69"
                                    VerticalAlignment="Center">

                                <Icon:PackIconMaterial Kind="Tools"
                                                       Foreground="#A78BFA"
                                                       Width="22"
                                                       Height="22"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Serviços Ativos"
                                           Style="{StaticResource TextoCard}"/>

                                <TextBlock x:Name="txtServicosAtivos"
                                           Text="0"
                                           Style="{StaticResource NumeroCard}"/>

                                <TextBlock Text="Disponíveis na plataforma"
                                           Foreground="#A78BFA"
                                           FontSize="11"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <!-- PEDIDOS PENDENTES -->

                    <Border Style="{StaticResource CardResumo}">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="42"
                                    Height="42"
                                    CornerRadius="21"
                                    Background="#3A3012"
                                    VerticalAlignment="Center">

                                <Icon:PackIconMaterial Kind="ClockAlertOutline"
                                                       Foreground="#FACC15"
                                                       Width="22"
                                                       Height="22"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Pedidos Pendentes"
                                           Style="{StaticResource TextoCard}"/>

                                <TextBlock x:Name="txtPedidosPendentes"
                                           Text="0"
                                           Style="{StaticResource NumeroCard}"/>

                                <TextBlock Text="Aguardando atendimento"
                                           Foreground="#FACC15"
                                           FontSize="11"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <!-- EM ANDAMENTO -->

                    <Border Style="{StaticResource CardResumo}">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="42"
                                    Height="42"
                                    CornerRadius="21"
                                    Background="#11315B"
                                    VerticalAlignment="Center">

                                <Icon:PackIconMaterial Kind="ProgressClock"
                                                       Foreground="#38BDF8"
                                                       Width="22"
                                                       Height="22"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Em Andamento"
                                           Style="{StaticResource TextoCard}"/>

                                <TextBlock x:Name="txtEmAndamento"
                                           Text="0"
                                           Style="{StaticResource NumeroCard}"/>

                                <TextBlock Text="Serviços sendo executados"
                                           Foreground="#38BDF8"
                                           FontSize="11"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <!-- MÉDIA DAS AVALIAÇÕES -->

                    <Border Style="{StaticResource CardResumo}"
                            Margin="0">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="42"
                                    Height="42"
                                    CornerRadius="21"
                                    Background="#123829"
                                    VerticalAlignment="Center">

                                <Icon:PackIconMaterial Kind="Star"
                                                       Foreground="#22C55E"
                                                       Width="22"
                                                       Height="22"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Média das Avaliações"
                                           Style="{StaticResource TextoCard}"/>

                                <TextBlock x:Name="txtMediaAvaliacoes"
                                           Text="0,0"
                                           Style="{StaticResource NumeroCard}"/>

                                <TextBlock Text="Notas de 1 a 5 estrelas"
                                           Foreground="#22C55E"
                                           FontSize="11"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </UniformGrid>

                <!-- ================================================= -->
                <!-- FILTROS -->
                <!-- ================================================= -->

                <Grid Grid.Row="2"
                      Margin="0 0 0 14">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- BUSCA -->

                    <Border Grid.Column="0"
                            Style="{StaticResource InputBox}"
                            Height="54"
                            Margin="0 0 12 0">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Icon:PackIconMaterial Kind="Magnify"
                                                   Width="18"
                                                   Height="18"
                                                   Foreground="#94A3B8"
                                                   VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                     x:Name="txtBusca"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     CaretBrush="White"
                                     FontSize="13"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Buscar por cliente, serviço, profissional ou prestador"
                                     TextChanged="TxtBusca_TextChanged"/>

                        </Grid>

                    </Border>

                    <!-- STATUS -->

                    <Border Grid.Column="1"
                            Background="#11162D"
                            BorderBrush="#252B46"
                            BorderThickness="1"
                            CornerRadius="10"
                            Height="54"
                            Padding="12 5"
                            Margin="0 0 12 0">

                        <StackPanel>

                            <TextBlock Text="Status"
                                       Foreground="#94A3B8"
                                       FontSize="10"/>

                            <ComboBox x:Name="cmbStatus"
                                      Style="{StaticResource ComboBoxModerno}"
                                      SelectionChanged="Filtro_Changed"/>

                        </StackPanel>

                    </Border>

                    <!-- PERÍODO -->

                    <Border Grid.Column="2"
                            Background="#11162D"
                            BorderBrush="#252B46"
                            BorderThickness="1"
                            CornerRadius="10"
                            Height="54"
                            Padding="12 5">

                        <StackPanel>

                            <TextBlock Text="Período"
                                       Foreground="#94A3B8"
                                       FontSize="10"/>

                            <ComboBox x:Name="cmbPeriodo"
                                      Style="{StaticResource ComboBoxModerno}"
                                      SelectionChanged="Filtro_Changed">

                                <ComboBoxItem Content="Todos"
                                              IsSelected="True"/>

                                <ComboBoxItem Content="Hoje"/>

                                <ComboBoxItem Content="Este mês"/>

                                <ComboBoxItem Content="Este ano"/>

                            </ComboBox>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- ================================================= -->
                <!-- GRÁFICO -->
                <!-- ================================================= -->

                <Border Grid.Row="3"
                        Background="#11162B"
                        BorderBrush="#1F2942"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16"
                        Margin="0 0 0 14">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Pedidos de Serviço por Mês"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Quantidade de serviços solicitados durante o ano"
                                           Foreground="#64748B"
                                           FontSize="11"
                                           Margin="0 2 0 0"/>

                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="#1A2038"
                                    BorderBrush="#2C3555"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10 5"
                                    VerticalAlignment="Top">

                                <TextBlock Text="Ano atual"
                                           Foreground="#CBD5E1"
                                           FontSize="11"/>

                            </Border>

                        </Grid>

                        <lvc:CartesianChart Grid.Row="1"
                                            x:Name="graficoPedidosMensais"
                                            Background="Transparent"
                                            Margin="0 8 0 0"/>

                    </Grid>

                </Border>

                <!-- ================================================= -->
                <!-- TABELA -->
                <!-- ================================================= -->

                <Border Grid.Row="4"
                        Background="#11162B"
                        BorderBrush="#1F2942"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14"
                        Margin="0 0 0 22"
                        MinHeight="300">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>

                        <!-- TÍTULO -->

                        <Grid Grid.Row="0"
                              Margin="2 0 2 10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Últimos pedidos de serviço"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Serviços encontrados com os filtros selecionados"
                                           Foreground="#64748B"
                                           FontSize="11"
                                           Margin="0 2 0 0"/>

                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       x:Name="txtQuantidadeRegistros"
                                       Text="0 registros"
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>

                        </Grid>

                        <!-- DATAGRID -->

                        <DataGrid Grid.Row="1"
                                  x:Name="dgServicosPedidos"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="White"
                                  RowHeight="62"
                                  ColumnHeaderHeight="38"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="Transparent"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="DgServicosPedidos_PreviewMouseWheel">

                            <DataGrid.Resources>

                                <Style TargetType="DataGridColumnHeader">

                                    <Setter Property="Background"
                                            Value="#141A31"/>

                                    <Setter Property="Foreground"
                                            Value="#CBD5E1"/>

                                    <Setter Property="FontWeight"
                                            Value="SemiBold"/>

                                    <Setter Property="FontSize"
                                            Value="12"/>

                                    <Setter Property="BorderBrush"
                                            Value="#232C48"/>

                                    <Setter Property="BorderThickness"
                                            Value="0 0 0 1"/>

                                    <Setter Property="Padding"
                                            Value="10 0"/>

                                </Style>

                                <Style TargetType="DataGridRow">

                                    <Setter Property="Background"
                                            Value="Transparent"/>

                                    <Setter Property="BorderThickness"
                                            Value="0"/>

                                    <Setter Property="Template">

                                        <Setter.Value>

                                            <ControlTemplate TargetType="DataGridRow">

                                                <Border x:Name="Linha"
                                                        Background="#151B34"
                                                        BorderBrush="#232C48"
                                                        BorderThickness="0 0 0 1">

                                                    <DataGridCellsPresenter/>

                                                </Border>

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">

                                                        <Setter TargetName="Linha"
                                                                Property="Background"
                                                                Value="#1A213D"/>

                                                    </Trigger>

                                                    <Trigger Property="IsSelected"
                                                             Value="True">

                                                        <Setter TargetName="Linha"
                                                                Property="Background"
                                                                Value="#20294A"/>

                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>

                                        </Setter.Value>

                                    </Setter>

                                </Style>

                                <Style TargetType="DataGridCell">

                                    <Setter Property="Background"
                                            Value="Transparent"/>

                                    <Setter Property="Foreground"
                                            Value="White"/>

                                    <Setter Property="BorderThickness"
                                            Value="0"/>

                                    <Setter Property="Padding"
                                            Value="10 0"/>

                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>

                                    <Setter Property="FocusVisualStyle"
                                            Value="{x:Null}"/>

                                </Style>

                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <!-- CLIENTE E EMPRESA -->

                                <DataGridTemplateColumn Header="Cliente"
                                                        Width="1.8*">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <StackPanel VerticalAlignment="Center">

                                                <TextBlock Text="{Binding Cliente}"
                                                           Foreground="White"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"/>

                                                <TextBlock Text="{Binding Prestador}"
                                                           Foreground="#64748B"
                                                           FontSize="10"
                                                           Margin="0 2 0 0"/>

                                            </StackPanel>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                                <!-- SERVIÇO -->

                                <DataGridTemplateColumn Header="Serviço"
                                                        Width="1.5*">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Border Background="#2B1B57"
                                                    CornerRadius="8"
                                                    Padding="8 3"
                                                    HorizontalAlignment="Left">

                                                <TextBlock Text="{Binding Servico}"
                                                           Foreground="#C084FC"
                                                           FontWeight="SemiBold"
                                                           FontSize="10"/>

                                            </Border>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                                <!-- PROFISSIONAL -->

                                <DataGridTextColumn Header="Profissional"
                                                    Binding="{Binding Profissional}"
                                                    Width="1.4*"/>

                                <!-- VALOR -->

                                <DataGridTextColumn Header="Valor"
                                                    Binding="{Binding ValorFormatado}"
                                                    Width="1*"/>

                                <!-- STATUS -->

                                <DataGridTemplateColumn Header="Status"
                                                        Width="1.2*">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Border CornerRadius="8"
                                                    Padding="8 3"
                                                    HorizontalAlignment="Left">

                                                <Border.Style>

                                                    <Style TargetType="Border">

                                                        <Setter Property="Background"
                                                                Value="#3A3012"/>

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="Em andamento">

                                                                <Setter Property="Background"
                                                                        Value="#11315B"/>

                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="Concluído">

                                                                <Setter Property="Background"
                                                                        Value="#10382B"/>

                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="Cancelado">

                                                                <Setter Property="Background"
                                                                        Value="#451927"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </Border.Style>

                                                <StackPanel Orientation="Horizontal">

                                                    <Ellipse Width="6"
                                                             Height="6"
                                                             Margin="0 0 6 0"
                                                             VerticalAlignment="Center">

                                                        <Ellipse.Style>

                                                            <Style TargetType="Ellipse">

                                                                <Setter Property="Fill"
                                                                        Value="#FACC15"/>

                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding Status}"
                                                                                 Value="Em andamento">

                                                                        <Setter Property="Fill"
                                                                                Value="#38BDF8"/>

                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding Status}"
                                                                                 Value="Concluído">

                                                                        <Setter Property="Fill"
                                                                                Value="#22C55E"/>

                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding Status}"
                                                                                 Value="Cancelado">

                                                                        <Setter Property="Fill"
                                                                                Value="#EF4444"/>

                                                                    </DataTrigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </Ellipse.Style>

                                                    </Ellipse>

                                                    <TextBlock Text="{Binding Status}"
                                                               FontWeight="SemiBold"
                                                               FontSize="10">

                                                        <TextBlock.Style>

                                                            <Style TargetType="TextBlock">

                                                                <Setter Property="Foreground"
                                                                        Value="#FACC15"/>

                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding Status}"
                                                                                 Value="Em andamento">

                                                                        <Setter Property="Foreground"
                                                                                Value="#38BDF8"/>

                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding Status}"
                                                                                 Value="Concluído">

                                                                        <Setter Property="Foreground"
                                                                                Value="#22C55E"/>

                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding Status}"
                                                                                 Value="Cancelado">

                                                                        <Setter Property="Foreground"
                                                                                Value="#EF4444"/>

                                                                    </DataTrigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </TextBlock.Style>

                                                    </TextBlock>

                                                </StackPanel>

                                            </Border>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                                <!-- DATA -->

                                <DataGridTextColumn Header="Data"
                                                    Binding="{Binding Data}"
                                                    Width="1*"/>

                                <!-- AÇÕES -->

                                <DataGridTemplateColumn Header="Ações"
                                                        Width="70">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Button Width="34"
                                                    Height="30"
                                                    Background="#171E36"
                                                    BorderBrush="#334155"
                                                    BorderThickness="1"
                                                    Cursor="Hand"
                                                    Click="BtnVisualizar_Click">

                                                <Button.Template>

                                                    <ControlTemplate TargetType="Button">

                                                        <Border x:Name="Fundo"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="7">

                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>

                                                        </Border>

                                                        <ControlTemplate.Triggers>

                                                            <Trigger Property="IsMouseOver"
                                                                     Value="True">

                                                                <Setter TargetName="Fundo"
                                                                        Property="Background"
                                                                        Value="#2A3558"/>

                                                            </Trigger>

                                                        </ControlTemplate.Triggers>

                                                    </ControlTemplate>

                                                </Button.Template>

                                                <Icon:PackIconMaterial Kind="EyeOutline"
                                                                       Width="15"
                                                                       Height="15"
                                                                       Foreground="White"/>

                                            </Button>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                        <!-- PAGINAÇÃO -->

                        <Grid Grid.Row="2"
                              Margin="4 8 4 0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="txtResumoPagina"
                                       Text="Mostrando 0 de 0 registros"
                                       Foreground="#64748B"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">

                                <Button x:Name="btnPaginaAnterior"
                                        Width="36"
                                        Height="32"
                                        Margin="0 0 6 0"
                                        Background="#171E36"
                                        Foreground="White"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Click="BtnPaginaAnterior_Click">

                                    <Icon:PackIconMaterial Kind="ChevronLeft"
                                                           Width="16"
                                                           Height="16"/>

                                </Button>

                                <Border MinWidth="90"
                                        Height="32"
                                        Background="#2D1B69"
                                        CornerRadius="7"
                                        Padding="10 0"
                                        Margin="0 0 6 0">

                                    <TextBlock x:Name="txtPaginaAtual"
                                               Text="Página 1 de 1"
                                               Foreground="#C4B5FD"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <Button x:Name="btnProximaPagina"
                                        Width="36"
                                        Height="32"
                                        Background="#171E36"
                                        Foreground="White"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Click="BtnProximaPagina_Click">

                                    <Icon:PackIconMaterial Kind="ChevronRight"
                                                           Width="16"
                                                           Height="16"/>

                                </Button>

                            </StackPanel>

                        </Grid>

                    </Grid>

                </Border>

            </Grid>

        </ScrollViewer>

        <!-- ================================================= -->
        <!-- FUNDO DO DRAWER -->
        <!-- ================================================= -->

        <Border x:Name="FundoDrawer"
                Panel.ZIndex="10"
                Background="#99000000"
                Visibility="Collapsed"
                Opacity="0"
                MouseLeftButtonDown="FundoDrawer_MouseLeftButtonDown"/>

        <!-- ================================================= -->
        <!-- DRAWER -->
        <!-- ================================================= -->

        <Border x:Name="DrawerServico"
                Panel.ZIndex="11"
                Width="410"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="#11162B"
                BorderBrush="#28324F"
                BorderThickness="1 0 0 0"
                Visibility="Collapsed">

            <Border.RenderTransform>

                <TranslateTransform x:Name="TransformDrawer"
                                    X="410"/>

            </Border.RenderTransform>

            <Grid Margin="24">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- CABEÇALHO -->

                <Grid Grid.Row="0"
                      Margin="0 0 0 22">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock x:Name="txtDrawerTitulo"
                                   Text="Pedido #0"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Detalhes do serviço solicitado"
                                   Foreground="#94A3B8"
                                   FontSize="12"
                                   Margin="0 3 0 0"/>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="36"
                            Height="36"
                            Background="#171E36"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="BtnFecharDrawer_Click">

                        <Icon:PackIconMaterial Kind="Close"
                                               Width="18"
                                               Height="18"
                                               Foreground="White"/>

                    </Button>

                </Grid>

                <!-- CONTEÚDO -->

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <!-- VALOR E STATUS -->

                        <Border Background="#171D36"
                                BorderBrush="#252B46"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16"
                                Margin="0 0 0 18">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Valor do serviço"
                                               Foreground="#94A3B8"
                                               FontSize="11"/>

                                    <TextBlock x:Name="txtDrawerValor"
                                               Text="R$ 0,00"
                                               Foreground="White"
                                               FontSize="27"
                                               FontWeight="Bold"
                                               Margin="0 4 0 0"/>

                                </StackPanel>

                                <Border Grid.Column="1"
                                        x:Name="brdDrawerStatus"
                                        Background="#3A3012"
                                        CornerRadius="9"
                                        Padding="10 5"
                                        VerticalAlignment="Center">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse x:Name="elipseDrawerStatus"
                                                 Width="7"
                                                 Height="7"
                                                 Fill="#FACC15"
                                                 Margin="0 0 7 0"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock x:Name="txtDrawerStatus"
                                                   Text="Pendente"
                                                   Foreground="#FACC15"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                        </Border>

                        <!-- CLIENTE -->

                        <Border Background="#151B34"
                                BorderBrush="#252B46"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="15"
                                Margin="0 0 0 10">

                            <StackPanel>

                                <TextBlock Text="Cliente"
                                           Foreground="#94A3B8"
                                           FontSize="11"/>

                                <TextBlock x:Name="txtDrawerCliente"
                                           Text="Cliente"
                                           Foreground="White"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0 5 0 0"/>

                            </StackPanel>

                        </Border>

                        <!-- SERVIÇO -->

                        <Border Background="#151B34"
                                BorderBrush="#252B46"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="15"
                                Margin="0 0 0 10">

                            <StackPanel>

                                <TextBlock Text="Serviço"
                                           Foreground="#94A3B8"
                                           FontSize="11"/>

                                <TextBlock x:Name="txtDrawerServico"
                                           Text="Serviço"
                                           Foreground="#C084FC"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0 5 0 0"/>

                            </StackPanel>

                        </Border>

                        <!-- PROFISSIONAL -->

                        <Border Background="#151B34"
                                BorderBrush="#252B46"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="15"
                                Margin="0 0 0 10">

                            <StackPanel>

                                <TextBlock Text="Profissional"
                                           Foreground="#94A3B8"
                                           FontSize="11"/>

                                <TextBlock x:Name="txtDrawerProfissional"
                                           Text="Profissional"
                                           Foreground="White"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0 5 0 0"/>

                            </StackPanel>

                        </Border>

                        <!-- EMPRESA -->

                        <Border Background="#151B34"
                                BorderBrush="#252B46"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="15"
                                Margin="0 0 0 10">

                            <StackPanel>

                                <TextBlock Text="Prestador"
                                           Foreground="#94A3B8"
                                           FontSize="11"/>

                                <TextBlock x:Name="txtDrawerPrestador"
                                           Text="Empresa"
                                           Foreground="#38BDF8"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0 5 0 0"/>

                            </StackPanel>

                        </Border>

                        <!-- DATA -->

                        <Border Background="#151B34"
                                BorderBrush="#252B46"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="15"
                                Margin="0 0 0 10">

                            <StackPanel>

                                <TextBlock Text="Data do pedido"
                                           Foreground="#94A3B8"
                                           FontSize="11"/>

                                <TextBlock x:Name="txtDrawerData"
                                           Text="00/00/0000"
                                           Foreground="White"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0 5 0 0"/>

                            </StackPanel>

                        </Border>

                        <!-- OBSERVAÇÃO -->

                        <Border Background="#151B34"
                                BorderBrush="#252B46"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="15">

                            <StackPanel>

                                <TextBlock Text="Observação"
                                           Foreground="#94A3B8"
                                           FontSize="11"/>

                                <TextBlock x:Name="txtDrawerObservacao"
                                           Text="Sem observações"
                                           Foreground="#CBD5E1"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0 7 0 0"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

                <!-- RODAPÉ -->

                <Button Grid.Row="2"
                        Height="44"
                        Margin="0 20 0 0"
                        Style="{StaticResource BotaoSecundario}"
                        Content="Fechar"
                        Click="BtnFecharDrawer_Click"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>