<UserControl x:Class="wpf_pi.Views.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B1024">

    <UserControl.Resources>

        <Style x:Key="CardResumo" TargetType="Border">
            <Setter Property="Background" Value="#171D36"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0 0 16 0"/>
        </Style>

        <Style x:Key="NumeroCard" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0 6 0 0"/>
        </Style>

        <Style x:Key="TextoCard" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="InputFiltro" TargetType="Control">
            <Setter Property="Background" Value="#11162D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#252B46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Height" Value="46"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <Grid>
            <StackPanel>
                <TextBlock Text="Usuários"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Visão geral de todos os usuários cadastrados no sistema."
                           Foreground="#CBD5E1"
                           FontSize="15"
                           Margin="0 6 0 0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0 12 0 0">

                <TextBlock Text="Home"
                           Foreground="#CBD5E1"
                           FontSize="14"/>

                <TextBlock Text=" / "
                           Foreground="#64748B"
                           Margin="8 0"/>

                <TextBlock Text="Usuários"
                           Foreground="#8B5CF6"
                           FontWeight="Bold"
                           FontSize="14"/>
            </StackPanel>
        </Grid>

        <!-- CARDS -->
        <UniformGrid Grid.Row="1"
                     Columns="5"
                     Margin="0 34 0 26">

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Text="Total de Usuários" Style="{StaticResource TextoCard}"/>
                    <TextBlock x:Name="txtTotalUsuarios" Text="0" Style="{StaticResource NumeroCard}"/>
                    <TextBlock Text="100% do total" Foreground="#8B5CF6" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Text="Administradores" Style="{StaticResource TextoCard}"/>
                    <TextBlock x:Name="txtTotalAdministradores" Text="0" Style="{StaticResource NumeroCard}"/>
                    <TextBlock Text="do total" Foreground="#FACC15" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Text="Profissionais" Style="{StaticResource TextoCard}"/>
                    <TextBlock x:Name="txtTotalProfissionais" Text="0" Style="{StaticResource NumeroCard}"/>
                    <TextBlock Text="do total" Foreground="#3B82F6" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Text="Clientes" Style="{StaticResource TextoCard}"/>
                    <TextBlock x:Name="txtTotalClientes" Text="0" Style="{StaticResource NumeroCard}"/>
                    <TextBlock Text="do total" Foreground="#22C55E" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Text="Empresas" Style="{StaticResource TextoCard}"/>
                    <TextBlock x:Name="txtTotalEmpresas" Text="0" Style="{StaticResource NumeroCard}"/>
                    <TextBlock Text="do total" Foreground="#EC4899" FontSize="12"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- FILTROS -->
        <Grid Grid.Row="2" Margin="0 0 0 22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtBusca"
                     Grid.Column="0"
                     Style="{StaticResource InputFiltro}"
                     FontSize="14"
                     TextChanged="txtBusca_TextChanged"/>

            <ComboBox x:Name="cmbTipo"
                      Grid.Column="1"
                      Margin="14 0 0 0"
                      Style="{StaticResource InputFiltro}"
                      SelectionChanged="Filtro_Changed">
                <ComboBoxItem Content="Todos" IsSelected="True"/>
                <ComboBoxItem Content="Administrador"/>
                <ComboBoxItem Content="Cliente"/>
                <ComboBoxItem Content="Profissional"/>
                <ComboBoxItem Content="Empresa"/>
            </ComboBox>

            <ComboBox x:Name="cmbStatus"
                      Grid.Column="2"
                      Margin="14 0 0 0"
                      Style="{StaticResource InputFiltro}"
                      SelectionChanged="Filtro_Changed">
                <ComboBoxItem Content="Todos" IsSelected="True"/>
                <ComboBoxItem Content="Ativo"/>
                <ComboBoxItem Content="Inativo"/>
            </ComboBox>

            <Button Grid.Column="3"
                    Content="Limpar filtros"
                    Margin="14 0 0 0"
                    Background="#171D36"
                    Foreground="White"
                    BorderBrush="#252B46"
                    Click="BtnLimparFiltros_Click"/>
        </Grid>

        <!-- LISTA -->
        <Border Grid.Row="3"
                Background="#11162D"
                CornerRadius="16"
                Padding="22">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Lista de Usuários"
                           Foreground="White"
                           FontSize="19"
                           FontWeight="Bold"
                           Margin="0 0 0 18"/>

                <DataGrid x:Name="dgUsuarios"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="White"
                          RowBackground="#171D36"
                          AlternatingRowBackground="#1A2040"
                          HorizontalGridLinesBrush="Transparent"
                          VerticalGridLinesBrush="Transparent"
                          ColumnHeaderHeight="42"
                          RowHeight="62">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#CBD5E1"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#ID" Binding="{Binding Id}" Width="70"/>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                        <DataGridTextColumn Header="Usuário" Binding="{Binding NomeUsuario}" Width="150"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="150"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                        <DataGridTextColumn Header="Cadastro" Binding="{Binding DataCadastro}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>