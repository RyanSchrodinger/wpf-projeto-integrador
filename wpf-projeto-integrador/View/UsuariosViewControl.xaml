<UserControl x:Class="wpf_pi.Views.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Icon ="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="#0B1024">

    <UserControl.Resources>

        <Style x:Key="CardResumo" TargetType="Border">
            <Setter Property="Background" Value="#171D36"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0 0 16 0"/>
        </Style>

        <Style x:Key="NumeroCard" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0 6 0 0"/>
        </Style>

        <Style x:Key="TextoCard" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="InputFiltro" TargetType="Control">
            <Setter Property="Background" Value="#11162D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#252B46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Height" Value="46"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <Grid>
            <StackPanel>
                <TextBlock Text="Usuários"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Visão geral de todos os usuários cadastrados no sistema."
                           Foreground="#CBD5E1"
                           FontSize="15"
                           Margin="0 6 0 0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0 12 0 0">

                <TextBlock Text="Home"
                           Foreground="#CBD5E1"
                           FontSize="14"/>

                <TextBlock Text=" / "
                           Foreground="#64748B"
                           Margin="8 0"/>

                <TextBlock Text="Usuários"
                           Foreground="#8B5CF6"
                           FontWeight="Bold"
                           FontSize="14"/>
            </StackPanel>
        </Grid>

        <!-- CARDS -->
        <UniformGrid Grid.Row="1"
                     Columns="5"
                     Margin="0 34 0 26">

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Text="Total de Usuários" Style="{StaticResource TextoCard}"/>
                    <TextBlock x:Name="txtTotalUsuarios" Text="0" Style="{StaticResource NumeroCard}"/>
                    <TextBlock Text="100% do total" Foreground="#8B5CF6" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Text="Administradores" Style="{StaticResource TextoCard}"/>
                    <TextBlock x:Name="txtTotalAdministradores" Text="0" Style="{StaticResource NumeroCard}"/>
                    <TextBlock Text="do total" Foreground="#FACC15" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Text="Profissionais" Style="{StaticResource TextoCard}"/>
                    <TextBlock x:Name="txtTotalProfissionais" Text="0" Style="{StaticResource NumeroCard}"/>
                    <TextBlock Text="do total" Foreground="#3B82F6" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Text="Clientes" Style="{StaticResource TextoCard}"/>
                    <TextBlock x:Name="txtTotalClientes" Text="0" Style="{StaticResource NumeroCard}"/>
                    <TextBlock Text="do total" Foreground="#22C55E" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardResumo}">
                <StackPanel>
                    <TextBlock Text="Empresas" Style="{StaticResource TextoCard}"/>
                    <TextBlock x:Name="txtTotalEmpresas" Text="0" Style="{StaticResource NumeroCard}"/>
                    <TextBlock Text="do total" Foreground="#EC4899" FontSize="12"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- FILTROS -->
        <Grid Grid.Row="2" Margin="0 0 0 22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtBusca"
                     Grid.Column="0"
                     Style="{StaticResource InputFiltro}"
                     FontSize="14"
                     TextChanged="txtBusca_TextChanged"/>

            <ComboBox x:Name="cmbTipo"
                      Grid.Column="1"
                      Margin="14 0 0 0"
                      Style="{StaticResource InputFiltro}"
                      SelectionChanged="Filtro_Changed">
                <ComboBoxItem Content="Todos" IsSelected="True"/>
                <ComboBoxItem Content="Administrador"/>
                <ComboBoxItem Content="Cliente"/>
                <ComboBoxItem Content="Profissional"/>
                <ComboBoxItem Content="Empresa"/>
            </ComboBox>

            <ComboBox x:Name="cmbStatus"
                      Grid.Column="2"
                      Margin="14 0 0 0"
                      Style="{StaticResource InputFiltro}"
                      SelectionChanged="Filtro_Changed">
                <ComboBoxItem Content="Todos" IsSelected="True"/>
                <ComboBoxItem Content="Ativo"/>
                <ComboBoxItem Content="Inativo"/>
            </ComboBox>

            <Button Grid.Column="3"
                    Content="Limpar filtros"
                    Margin="14 0 0 0"
                    Background="#171D36"
                    Foreground="White"
                    BorderBrush="#252B46"
                    Click="BtnLimparFiltros_Click"/>
        </Grid>

        <!-- LISTA -->

        <!-- LISTA -->
        <Border Grid.Row="3"
        Background="#11162B"
        BorderBrush="#1F2942"
        BorderThickness="1"
        CornerRadius="18"
        Padding="15">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOPO -->
                <Grid Margin="0 0 0 18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Lista de Usuários"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                        <TextBlock Text="Ordenar por:"
                           Foreground="#CBD5E1"
                           VerticalAlignment="Center"
                           Margin="0 0 8 0"/>

                        <ComboBox Width="160"
                          Height="38"
                          Background="#0F1428"
                          Foreground="White"
                          BorderBrush="#252B46">

                            <ComboBoxItem Content="Mais recentes"
                                  IsSelected="True"/>

                            <ComboBoxItem Content="Mais antigos"/>
                            <ComboBoxItem Content="Nome"/>

                        </ComboBox>

                    </StackPanel>
                </Grid>

                <!-- DATAGRID -->
                <DataGrid x:Name="dgUsuarios"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="White"
                  RowHeight="58"
                  ColumnHeaderHeight="42"
                  RowBackground="Transparent"
                  AlternatingRowBackground="Transparent">

                    <DataGrid.Resources>

                        <!-- HEADER -->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#CBD5E1"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10 0"/>
                        </Style>

                        <!-- LINHA COMO CARD -->
                        <Style TargetType="DataGridRow">
                            <Setter Property="Margin" Value="0 0 0 6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridRow">
                                        <Border Background="#151B34"
                                        BorderBrush="#252B46"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True">

                                            <SelectiveScrollingGrid>
                                                <SelectiveScrollingGrid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </SelectiveScrollingGrid.ColumnDefinitions>

                                                <DataGridCellsPresenter Grid.Column="1"/>
                                            </SelectiveScrollingGrid>

                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- CÉLULAS -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10 0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>

                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <!-- USUÁRIO -->
                        <DataGridTemplateColumn Header="Usuário"
                                        Width="3*">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                        <!-- FOTO FAKE -->
                                        <Border Width="34"
                                        Height="34"
                                        CornerRadius="17"
                                        Background="#7C3AED"
                                        VerticalAlignment="Center">

                                            <TextBlock Text="{Binding Iniciais}"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                        </Border>

                                        <!-- INFO -->
                                        <StackPanel Margin="12 0 0 0"
                                            VerticalAlignment="Center">

                                            <TextBlock Text="{Binding Nome}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>

                                            <TextBlock Text="{Binding Email}"
                                               Foreground="#94A3B8"
                                               FontSize="11"/>

                                        </StackPanel>

                                    </StackPanel>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                        <!-- NOME DE USUÁRIO -->
                        <DataGridTextColumn Header="Usuário"
                                    Binding="{Binding NomeUsuario}"
                                    Width="1.4*"/>

                        <!-- TIPO -->
                        <DataGridTemplateColumn Header="Tipo"
                                        Width="1.2*">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Border CornerRadius="8"
                                    Padding="9 3"
                                    HorizontalAlignment="Left">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#2B1B57"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tipo}" Value="Administrador">
                                                        <Setter Property="Background" Value="#2B1B57"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Tipo}" Value="Cliente">
                                                        <Setter Property="Background" Value="#0B2A5B"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Tipo}" Value="Profissional">
                                                        <Setter Property="Background" Value="#31205F"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Tipo}" Value="Empresa">
                                                        <Setter Property="Background" Value="#5A1F3F"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding Tipo}"
                                           FontWeight="SemiBold"
                                           FontSize="11">

                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#A855F7"/>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tipo}" Value="Administrador">
                                                            <Setter Property="Foreground" Value="#A855F7"/>
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Tipo}" Value="Cliente">
                                                            <Setter Property="Foreground" Value="#3B82F6"/>
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Tipo}" Value="Profissional">
                                                            <Setter Property="Foreground" Value="#C084FC"/>
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Tipo}" Value="Empresa">
                                                            <Setter Property="Foreground" Value="#F472B6"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>

                                        </TextBlock>

                                    </Border>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                        <!-- STATUS -->
                        <DataGridTemplateColumn Header="Status"
                                        Width="1*">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Border CornerRadius="8"
                                    Padding="9 3"
                                    HorizontalAlignment="Left">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#0F3B2E"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Inativo">
                                                        <Setter Property="Background" Value="#4A1D2A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel Orientation="Horizontal">

                                            <Ellipse Width="7"
                                             Height="7"
                                             VerticalAlignment="Center"
                                             Margin="0 0 6 0">

                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#22C55E"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Inativo">
                                                                <Setter Property="Fill" Value="#EF4444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>

                                            </Ellipse>

                                            <TextBlock Text="{Binding Status}"
                                               FontWeight="SemiBold"
                                               FontSize="11">

                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#22C55E"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Inativo">
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>

                                            </TextBlock>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                        <!-- CADASTRO -->
                        <DataGridTextColumn Header="Cadastro"
                                    Binding="{Binding DataCadastro}"
                                    Width="1.2*"/>

                        <!-- AÇÕES -->
                        <DataGridTemplateColumn Header="Ações"
                                        Width="120">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal">

                                        <Button Width="38"
                                        Height="34"
                                        Background="#151A32"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        Margin="0 0 8 0">

                                            <Icon:PackIconMaterial Kind="EyeOutline"
                                                           Width="16"
                                                           Height="16"
                                                           Foreground="White"/>

                                        </Button>

                                        <Button Width="38"
                                        Height="34"
                                        Background="#151A32"
                                        BorderBrush="#7C3AED"
                                        BorderThickness="1">

                                            <Icon:PackIconMaterial Kind="PencilOutline"
                                                           Width="16"
                                                           Height="16"
                                                           Foreground="White"/>

                                        </Button>

                                    </StackPanel>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>


    </Grid>
</UserControl>