<Window x:Class="wpf_projeto_integrador.FormMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon ="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Music Station - Painel Administrador"
        Height="720"
        Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#151527">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MenuColumn" Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Margin="15,15,5,15"
                CornerRadius="28"
                Background="#1F1F35">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="130"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="90"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Vertical" VerticalAlignment="Top"
                            Margin="18 20 18 0">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Top">

                        <Button Style="{StaticResource IconButton}"
                                Width="42"
                                Height="42">

                            <Icon:PackIconMaterial Kind="Menu"
                                   Width="22"
                                   Height="22"/>

                        </Button>


                    </StackPanel>
                    <TextBlock 
                           Text="MUSIC"
                           Foreground="#5B2A86"
                           FontSize="26"
                           FontWeight="Black"
                           Margin="0 0 0 0"/>

                    <TextBlock 
                        Margin="0 -8 0 0 "
                           Text="STATION"
                           Foreground="#F4C430"
                           FontSize="26"
                           FontWeight="Black"/>
                </StackPanel>




                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Orientation="Vertical">

                        <Button Style="{StaticResource MenuButton}">
                            <StackPanel Orientation="Horizontal">

                                <Icon:PackIconMaterial Kind="ViewDashboard"
                                       Width="22"
                                       Height="22" 
                                       Margin="0 0 12 0"/>

                                <TextBlock Text="Dashboard"/>

                            </StackPanel>
                        </Button>

                        <StackPanel>
                            <Button Style="{StaticResource MenuButton}"
                                    Click="BtnGestaoPessoas_Click">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Icon:PackIconMaterial Kind="AccountGroup"
                                                       Width="24"
                                                       Height="24"
                                                       VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                           Text="Gestão de Pessoas"
                                           Margin="14 0 0 0"
                                           VerticalAlignment="Center"/>

                                    <Icon:PackIconMaterial x:Name="SetaPessoas"
                                                       Grid.Column="2"
                                                       Kind="ChevronDown"
                                                       Width="14"
                                                       Height="14"
                                                       VerticalAlignment="Center"/>
                                </Grid>


                            </Button>

                            <StackPanel x:Name="SubMenuPessoas"
                                        Visibility="Collapsed"
                                        Margin="42 0 0 0">




                                <Button Click="BtnUsuarios_Click"
                                        Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Usuários"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                                <Button Click="BtnAdministradores_Click"
                                        Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Administradores"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>

                                <Button  Style="{StaticResource SubMenuButton}">
                                  
                                    <StackPanel Orientation="Horizontal">
                                      
                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Profissionais"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>
                                

                                <Button  Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Clientes"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                                <Button  Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Empresas"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>


                                <Button  Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Profissional Cargo"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>
                            </StackPanel>

                        </StackPanel>


                        <StackPanel>
                            <Button Style="{StaticResource MenuButton}"
                                      Click="BtnGestaoFinanceira_Click">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>


                                    <Icon:PackIconMaterial Kind="Finance"
                                            Width="24"
                                            Height="24"/>

                                    <TextBlock Text="Gestão de Finanças"
                                               Grid.Column="1"
                                               Margin="14 0 0 0"
                                               VerticalAlignment="Center"/>

                                    <Icon:PackIconMaterial x:Name="SetaFinancas"
                                                           Grid.Column="2"
                                                           Kind="ChevronDown"
                                                           Width="14"
                                                           Height="14"
                                                           VerticalAlignment="Center"/>

                                </Grid>
                            </Button>

                            <StackPanel x:Name="SubMenuFinancas"
                                         Visibility="Collapsed"
                                         Margin="42 0 0 0">


                                <Button  Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Pagamentos"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                                <Button  Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Transações"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                                <Button  Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Forma Pagamento"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                            </StackPanel>

                        </StackPanel>


                        <StackPanel>
                            <Button Style="{StaticResource MenuButton}"
                                    Click="BtnGestaoServicos_Click">


                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>


                                    <Icon:PackIconMaterial Kind="Hammer"
                                                            Width="24"
                                                            Height="24"/>

                                    <TextBlock Text="Gestão de Serviços"
                                               Margin="14 0 0 0"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"/>

                                    <Icon:PackIconMaterial x:Name="SetaServicos"
                                                           Grid.Column="2"
                                                           Kind="ChevronDown"
                                                           Width="14"
                                                           Height="14"
                                                           VerticalAlignment="Center"/>
                                </Grid>


                            </Button>

                            <StackPanel x:Name="SubMenuServicos"
                                        Visibility="Collapsed"
                                        Margin="42 0 0 0">


                                <Button  Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Serviços"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                                <Button  Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Pedidos"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                                <Button  Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Serviços Pedidos"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                                <Button  Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Avaliações"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                            </StackPanel>

                        </StackPanel>

                        <StackPanel>
                            <Button Style="{StaticResource MenuButton}"
                                    Click="BtnGestaoLocacoes_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>


                                    <Icon:PackIconMaterial Kind="AccountCard"
                                    Width="24"
                                    Height="24"/>

                                    <TextBlock Text="Gestão de Locações"
                                               Margin="14 0 0 0"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"/>

                                    <Icon:PackIconMaterial x:Name="SetaLocacoes"
                                                           Grid.Column="2"
                                                           Kind="ChevronDown"
                                                           Width="14"
                                                           Height="14"
                                                           VerticalAlignment="Center"/>
                                </Grid>

                            </Button>

                            <StackPanel x:Name="SubMenuLocacoes"
                                        Visibility="Collapsed"
                                        Margin="42 0 0 0">


                                <Button  Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Locações"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>





                                <Button  Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Locações Itens"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                                <Button  Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Instrumentos"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                            </StackPanel>

                        </StackPanel>


                        <Button Style="{StaticResource MenuButton}" Click="Button_Click">
                            <StackPanel Orientation="Horizontal" >

                                <Icon:PackIconMaterial Kind="Chat"
                                       Height="22"
                                       Width="22"
                                       Margin="0 0 12 0"/>

                                <TextBlock Text="Comunicação"/>

                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButton}">
                            <StackPanel Orientation="Horizontal">

                                <Icon:PackIconMaterial Kind="Github"
                                       Height="22"
                                       Width="22"
                                       Margin="0 0 12 0"/>

                                <TextBlock Text="Configuração"/>

                            </StackPanel>
                        </Button>

                        <Button x:Name="btnLogs"
                                Style="{StaticResource MenuButton}"
                                Click="btnLogs_Click">

                            <StackPanel Orientation="Horizontal">

                                <Icon:PackIconMaterial Kind="FileDocument"
                                       Height="22"
                                       Width="22"
                                       Margin="0 0 12 0"/>

                                <TextBlock Text="Logs"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </ScrollViewer>



            </Grid>


        </Border>

        <!-- CONTEÚDO PRINCIPAL -->
        <Grid Grid.Column="1" Margin="0 18 18 18">

            <ContentControl x:Name="MainContent" Margin="10,0,0,0"/>



        </Grid>
    </Grid>
</Window>