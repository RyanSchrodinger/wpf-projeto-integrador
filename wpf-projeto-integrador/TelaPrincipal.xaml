<Window x:Class="wpf_projeto_integrador.FormMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon ="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Music Station - Painel Administrador"
        Height="720"
        Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#151527">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MenuColumn" Width="133.333"/>
            <ColumnDefinition Width="136.667"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Margin="15,15,5,15"
                CornerRadius="28"
                Background="#1F1F35" Grid.ColumnSpan="2">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="130"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="90"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Vertical" VerticalAlignment="Top"
                            Margin="18 20 18 0">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Top">

                        <Button Style="{StaticResource IconButton}"
                                Width="42"
                                Height="42">

                            <Icon:PackIconMaterial Kind="Menu"
                                   Width="22"
                                   Height="22"/>

                        </Button>


                    </StackPanel>
                    <TextBlock 
                           Text="MUSIC"
                           Foreground="#5B2A86"
                           FontSize="26"
                           FontWeight="Black"
                           Margin="0 0 0 0"/>

                    <TextBlock 
                        Margin="0 -8 0 0 "
                           Text="STATION"
                           Foreground="#F4C430"
                           FontSize="26"
                           FontWeight="Black"/>
                </StackPanel>




                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Orientation="Vertical">


                        <Button x:Name="BtnDashboard"
                                Style="{StaticResource MenuButton}">
                            <StackPanel Orientation="Horizontal">

                                <Icon:PackIconMaterial Kind="ViewDashboard"
                                                       Width="22"
                                                       Height="22" 
                                                       Margin="0 0 12 0"/>

                                <TextBlock Text="Dashboard"/>

                            </StackPanel>
                        </Button>

                        <StackPanel>
                            <Button x:Name="BtnGestaoPessoas"
                                    Style="{StaticResource MenuButton}"
                                    Click="BtnGestaoPessoas_Click">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Icon:PackIconMaterial Kind="AccountGroup"
                                                           Width="24"
                                                           Height="24"
                                                           VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="Gestão de Pessoas"
                                               Margin="14 0 0 0"
                                               VerticalAlignment="Center"/>

                                    <Icon:PackIconMaterial x:Name="SetaPessoas"
                                                           Grid.Column="2"
                                                           Kind="ChevronDown"
                                                           Width="14"
                                                           Height="14"
                                                           VerticalAlignment="Center"/>
                                </Grid>


                            </Button>

                            <StackPanel x:Name="SubMenuPessoas"
                                        Visibility="Collapsed"
                                        Margin="42 0 0 0">




                                <Button x:Name="BtnUsuarios"
                                        Click="BtnUsuarios_Click"
                                        Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Usuários"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                                <Button x:Name="BtnAdministradores"
                                        Click="BtnAdministradores_Click"
                                        Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Administradores"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>

                                <Button x:Name="BtnProfissionais"
                                        Click="BtnProfissional_Click"
                                        Style="{StaticResource SubMenuButton}">
                                    

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Profissionais"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>


                                <Button x:Name="BtnClientes"
                                        Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Clientes"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                                <Button x:Name="BtnEmpresas"
                                        Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Empresas"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>


                                <Button x:Name="BtnProfissionalCargo"
                                        Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Profissional Cargo"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>
                            </StackPanel>

                        </StackPanel>


                        <StackPanel>
                            <Button x:Name="BtnGestaoFinanceira"
                                    Style="{StaticResource MenuButton}"
                                    Click="BtnGestaoFinanceira_Click">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>


                                    <Icon:PackIconMaterial Kind="Finance"
                                                            Width="24"
                                                            Height="24"/>

                                    <TextBlock Text="Gestão de Finanças"
                                                Grid.Column="1"
                                                Margin="14 0 0 0"
                                                VerticalAlignment="Center"/>

                                    <Icon:PackIconMaterial x:Name="SetaFinancas"
                                   Grid.Column="2"
                                   Kind="ChevronDown"
                                   Width="14"
                                   Height="14"
                                   VerticalAlignment="Center"/>

                                </Grid>
                            </Button>

                            <StackPanel x:Name="SubMenuFinancas"
                 Visibility="Collapsed"
                 Margin="42 0 0 0">


                                <Button x:Name="BtnPagamentos"
                Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                         Height="6"
                         Fill="#8B5CF6"
                         VerticalAlignment="Center"/>

                                        <TextBlock Text="Pagamentos"
                           Margin="14 0 0 0"
                           VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                                <Button x:Name="BtnTransacoes"
                Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                         Height="6"
                         Fill="#8B5CF6"
                         VerticalAlignment="Center"/>

                                        <TextBlock Text="Transações"
                           Margin="14 0 0 0"
                           VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                                <Button x:Name="BtnFormaPagamento"
                Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                         Height="6"
                         Fill="#8B5CF6"
                         VerticalAlignment="Center"/>

                                        <TextBlock Text="Forma Pagamento"
                           Margin="14 0 0 0"
                           VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                            </StackPanel>

                        </StackPanel>


                        <StackPanel>
                            <Button x:Name="BtnGestaoServicos"
            Style="{StaticResource MenuButton}"
            Click="BtnGestaoServicos_Click">


                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>


                                    <Icon:PackIconMaterial Kind="Hammer"
                                    Width="24"
                                    Height="24"/>

                                    <TextBlock Text="Gestão de Serviços"
                       Margin="14 0 0 0"
                       Grid.Column="1"
                       VerticalAlignment="Center"/>

                                    <Icon:PackIconMaterial x:Name="SetaServicos"
                                   Grid.Column="2"
                                   Kind="ChevronDown"
                                   Width="14"
                                   Height="14"
                                   VerticalAlignment="Center"/>
                                </Grid>


                            </Button>

                            <StackPanel x:Name="SubMenuServicos"
                Visibility="Collapsed"
                Margin="42 0 0 0">


                                <Button x:Name="BtnServicos"
                                         Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                    Fill="#8B5CF6"
                                                    VerticalAlignment="Center"/>            

                                        <TextBlock Text="Serviços"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                                <Button x:Name="BtnPedidos"
                                         Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Pedidos"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                                <Button x:Name="BtnServicosPedidos"
                                      Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Serviços Pedidos"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                                <Button x:Name="BtnAvaliacoes"
                                        Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Avaliações"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                            </StackPanel>

                        </StackPanel>

                        <StackPanel>
                            <Button x:Name="BtnGestaoLocacoes"
                                    Style="{StaticResource MenuButton}"
                                    Click="BtnGestaoLocacoes_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>


                                    <Icon:PackIconMaterial Kind="AccountCard"
                                                            Width="24"
                                                            Height="24"/>

                                    <TextBlock Text="Gestão de Locações"
                                               Margin="14 0 0 0"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"/>

                                    <Icon:PackIconMaterial x:Name="SetaLocacoes"
                                   Grid.Column="2"
                                   Kind="ChevronDown"
                                   Width="14"
                                   Height="14"
                                   VerticalAlignment="Center"/>
                                </Grid>

                            </Button>

                            <StackPanel x:Name="SubMenuLocacoes"
                                        Visibility="Collapsed"
                                        Margin="42 0 0 0">


                                <Button x:Name="BtnLocacoes"
                                        Style="{StaticResource SubMenuButton}">
    
                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Locações"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>





                                <Button x:Name="BtnLocacoesItens"
                                         Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Locações Itens"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                                <Button x:Name="BtnInstrumentos"
                                        Style="{StaticResource SubMenuButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#8B5CF6"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Instrumentos"
                                                   Margin="14 0 0 0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>


                                </Button>



                            </StackPanel>

                        </StackPanel>


                        <Button x:Name="BtnComunicacao"
                                Style="{StaticResource MenuButton}"
                                Click="Button_Click">
                            <StackPanel Orientation="Horizontal" >

                                <Icon:PackIconMaterial Kind="Chat"
                                                       Height="22"
                                                       Width="22"
                                                       Margin="0 0 12 0"/>

                                <TextBlock Text="Comunicação"/>

                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnConfiguracao"
                                Style="{StaticResource MenuButton}">
                            <StackPanel Orientation="Horizontal">

                                <Icon:PackIconMaterial Kind="Github"
                                                       Height="22"
                                                       Width="22"
                                                       Margin="0 0 12 0"/>

                                <TextBlock Text="Configuração"/>

                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnLogs"
                                Style="{StaticResource MenuButton}"
                                Click="btnLogs_Click">

                            <StackPanel Orientation="Horizontal">

                                <Icon:PackIconMaterial Kind="FileDocument"
                                                       Height="22"
                                                       Width="22"
                                                       Margin="0 0 12 0"/>

                                <TextBlock Text="Logs"/>

                            </StackPanel>

                        </Button>



                    </StackPanel>

                </ScrollViewer>

                <!-- CONTA LOGADA -->
                <!-- CONTA LOGADA -->
                <Border Grid.Row="2"
                        BorderBrush="#2A3558"
                        BorderThickness="1,1,0,0"
                        Background="#1F1F35"
                        CornerRadius="0,0,22,22" Margin="0,10,0,0">

                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="38"
                                Height="38"
                                CornerRadius="19"
                                Background="#6D28D9"
                                VerticalAlignment="Center">

                            <TextBlock x:Name="txtIniciaisUsuario"
                                       Text="?"
                                       Foreground="White"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock x:Name="txtNomeUsuarioLogado"
                                       Text="Usuário"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock x:Name="txtCargoUsuarioLogado"
                                       Text="Administrador"
                                       Foreground="#B8C0DD"
                                       FontSize="12"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Icon:PackIconMaterial Grid.Column="2"
                               Kind="ChevronDown"
                               Width="17"
                               Height="17"
                               Foreground="#D6DCF7"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                    </Grid>
                </Border>



            </Grid>


        </Border>

        <!-- CONTEÚDO PRINCIPAL -->
        <Grid Grid.Column="2" Margin="0,10,18,18" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="219*"/>
            </Grid.ColumnDefinitions>

            <ContentControl x:Name="MainContent" Margin="10,10,0,0" Grid.ColumnSpan="3" />



        </Grid>
    </Grid>
</Window>