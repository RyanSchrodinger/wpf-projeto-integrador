<Window x:Class="wpf_projeto_integrador.FormMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon ="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Music Station - Painel Administrador"
        Height="720"
        Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#151527">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MenuColumn" Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Margin="15,15,5,15"
                CornerRadius="28"
                Background="#1F1F35">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="130"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="90"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Vertical" VerticalAlignment="Top"
                            Margin="18 20 18 0">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Top">

                        <Button Style="{StaticResource IconButton}"
                                Width="42"
                                Height="42">

                            <Icon:PackIconMaterial Kind="Menu"
                                   Width="22"
                                   Height="22"/>

                        </Button>


                    </StackPanel>
                    <TextBlock 
                           Text="MUSIC"
                           Foreground="#5B2A86"
                           FontSize="26"
                           FontWeight="Black"
                           Margin="0 0 0 0"/>

                    <TextBlock 
                        Margin="0 -8 0 0 "
                           Text="STATION"
                           Foreground="#F4C430"
                           FontSize="26"
                           FontWeight="Black"/>
                </StackPanel>




                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Orientation="Vertical">

                        <Button Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                <Icon:PackIconMaterial Kind="ViewDashboard"
                                       Width="22"
                                       Height="22" 
                                       Margin="0 0 12 0"/>

                                <TextBlock Text="Dashboard"/>

                            </StackPanel>
                        </Button>

                        <StackPanel>
                            <Button Style="{StaticResource MenuButton}"
                                     Click="BtnGestaoPessoas_Click">

                                <StackPanel Orientation="Horizontal">

                                    <Icon:PackIconMaterial Kind="AccountGroup"
                                           Width="24"
                                           Height="24"/>

                                    <TextBlock Text="Gestão de Pessoas"
                               Margin="14 0 0 0"/>

                                </StackPanel>

                            </Button>

                            <StackPanel x:Name="SubMenuPessoas"
                                        Visibility="Collapsed"
                                        Margin="42 0 0 0">

                                <Button Content="Administradores"
                                        Style="{StaticResource SubMenuButton}"/>

                                <Button Content="Usuários"
                                        Style="{StaticResource SubMenuButton}"/>

                                <Button Content="Profissionais"
                                        Style="{StaticResource SubMenuButton}"/>

                                <Button Content="Clientes"
                                        Style="{StaticResource SubMenuButton}"/>

                                <Button Content="Empresas"
                                        Style="{StaticResource SubMenuButton}"/>

                                <Button Content="Profissional Cargo"
                                        Style="{StaticResource SubMenuButton}"/>

                            </StackPanel>

                        </StackPanel>


                        <StackPanel>
                            <Button Style="{StaticResource MenuButton}"
                                      Click="BtnGestaoFinanceira_Click">

                                <StackPanel Orientation="Horizontal">

                                    <Icon:PackIconMaterial Kind="Finance"
                                            Width="24"
                                            Height="24"/>

                                    <TextBlock Text="Gestão de Finanças"
                                Margin="14 0 0 0"/>

                                </StackPanel>

                            </Button>

                            <StackPanel x:Name="SubMenuFinancas"
                                         Visibility="Collapsed"
                                         Margin="42 0 0 0">

                                <Button Content="Pagamentos"
                                         Style="{StaticResource SubMenuButton}"/>

                                <Button Content="Transações"
                                         Style="{StaticResource SubMenuButton}"/>

                                <Button Content="Forma Pagamento"
                                         Style="{StaticResource SubMenuButton}"/>


                            </StackPanel>

                        </StackPanel>


                        <StackPanel>
                            <Button Style="{StaticResource MenuButton}"
                                    Click="BtnGestaoFinanceira_Click">

                                <StackPanel Orientation="Horizontal">

                                    <Icon:PackIconMaterial Kind="Hammer"
                                                            Width="24"
                                                            Height="24"/>

                                    <TextBlock Text="Gestão de Serviços"
                                                Margin="14 0 0 0"/>

                                </StackPanel>

                            </Button>

                            <StackPanel x:Name="SubMenuServicos"
                                        Visibility="Collapsed"
                                        Margin="42 0 0 0">

                                <Button Content="Pagamentos"
                                        Style="{StaticResource SubMenuButton}"/>

                                <Button Content="Transações"
                                        Style="{StaticResource SubMenuButton}"/>

                                <Button Content="Forma Pagamento"
                                        Style="{StaticResource SubMenuButton}"/>


                            </StackPanel>

                        </StackPanel>






















                        <Button Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                <Icon:PackIconMaterial Kind="AccountCard"
                                       Height="22"
                                       Width="22"
                                       Margin="0 0 12 0"/>

                                <TextBlock Text="Gestão de Locações"/>

                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                <Icon:PackIconMaterial Kind="Chat"
                                       Height="22"
                                       Width="22"
                                       Margin="0 0 12 0"/>

                                <TextBlock Text="Comunicação"/>

                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                <Icon:PackIconMaterial Kind="Github"
                                       Height="22"
                                       Width="22"
                                       Margin="0 0 12 0"/>

                                <TextBlock Text="Configuração"/>

                            </StackPanel>
                        </Button>

                        <Button x:Name="btnLogs"
                                Style="{StaticResource SidebarButton}"
                                Click="btnLogs_Click">

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                <Icon:PackIconMaterial Kind="FileDocument"
                                       Height="22"
                                       Width="22"
                                       Margin="0 0 12 0"/>

                                <TextBlock Text="Logs"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </ScrollViewer>



            </Grid>


        </Border>

        <!-- CONTEÚDO PRINCIPAL -->
        <Grid Grid.Column="1" Margin="0 18 18 18">

            <ContentControl x:Name="MainContent" Margin="10,0,0,0"/>





        </Grid>
    </Grid>
</Window>